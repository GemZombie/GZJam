<Project>
  <!--
    Copies the native BASS libraries next to an executable. Import this from every app project
    that uses GZJam.Audio. It has to live in the executable, not the library: when publishing
    with -r <rid>, .NET doesn't pass the RID to referenced class libraries, so only the app
    knows which platform it's being built for.

    Picked by target RID, or by the build OS when no RID is given (dotnet run / build).
    lib/bass/osx holds universal binaries (Intel + Apple Silicon), so both macOS RIDs use it.
  -->
  <PropertyGroup>
    <BassRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</BassRid>
    <BassRid Condition="$(BassRid.StartsWith('osx'))">osx</BassRid>
    <BassRid Condition="'$(BassRid)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">win-x64</BassRid>
    <BassRid Condition="'$(BassRid)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">osx</BassRid>
    <BassRid Condition="'$(BassRid)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">linux-x64</BassRid>
    <BassDir>$(MSBuildThisFileDirectory)$(BassRid)\</BassDir>
  </PropertyGroup>

  <!--
    macOS: libbass_fx and libbassmix load libbass through @rpath, which doesn't include their own
    folder, so they fail to load ("Library not loaded: @rpath/libbass.dylib"). Built on a Mac,
    copies of them are pointed at @loader_path (their own folder) and signed again, ad hoc. A
    macOS build made on Windows or Linux can't do this and won't load them.
  -->
  <PropertyGroup Condition="'$(BassRid)' == 'osx' And $([MSBuild]::IsOSPlatform('OSX'))">
    <BassDir>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)bass-osx/</BassDir>
    <BassPatchForMac>true</BassPatchForMac>
  </PropertyGroup>

  <ItemGroup Condition="'$(BassPatchForMac)' == 'true'">
    <BassMacLibrary Include="$(MSBuildThisFileDirectory)osx\*.dylib" />
    <None Include="@(BassMacLibrary->'$(BassDir)%(Filename)%(Extension)')"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(BassPatchForMac)' != 'true'">
    <None Include="$(BassDir)*.dll;$(BassDir)*.so;$(BassDir)*.dylib"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <Target Name="PatchBassForMac" Condition="'$(BassPatchForMac)' == 'true'" BeforeTargets="PrepareForBuild"
          Inputs="@(BassMacLibrary)" Outputs="@(BassMacLibrary->'$(BassDir)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(BassMacLibrary)" DestinationFolder="$(BassDir)" />
    <Exec Command="install_name_tool -change @rpath/libbass.dylib @loader_path/libbass.dylib &quot;$(BassDir)%(BassMacLibrary.Filename)%(BassMacLibrary.Extension)&quot;"
          IgnoreStandardErrorWarningFormat="true" />
    <Exec Command="codesign --force --sign - &quot;$(BassDir)%(BassMacLibrary.Filename)%(BassMacLibrary.Extension)&quot;" />
  </Target>
</Project>
