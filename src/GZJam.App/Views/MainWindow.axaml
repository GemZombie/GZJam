<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:GZJam.App"
        xmlns:vm="using:GZJam.App.ViewModels"
        xmlns:v="using:GZJam.App.Views"
        xmlns:lib="using:GZJam.Library"
        xmlns:c="using:GZJam.App.Controls"
        x:Class="GZJam.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GZJam"
        Icon="/Assets/gzjam.png"
        Width="1440" Height="900" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        c:AlbumArt.Cache="{Binding Art}">

  <Panel>
  <DockPanel x:Name="WindowRoot">

    <!-- ───────────── Top bar ─────────────
         On Windows and macOS it is also the window's title bar: its empty space moves the window,
         and the system's own buttons sit at its end (see MainWindow.UseTopBarAsTitleBar). -->
    <Border x:Name="TopBar" DockPanel.Dock="Top" Height="{DynamicResource TopBarHeight}"
            Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
      <DockPanel>
      <!-- Windows: minimize, maximize (or restore) and close, drawn and handled by GZJam -->
      <StackPanel x:Name="CaptionButtons" DockPanel.Dock="Right" Orientation="Horizontal" IsVisible="False">
        <Button x:Name="MinimizeButton" Focusable="False" Classes="caption" Content="&#xE921;" AutomationProperties.Name="Minimize" />
        <Button x:Name="MaximizeButton" Focusable="False" Classes="caption" Content="&#xE922;" AutomationProperties.Name="Maximize" />
        <Button x:Name="CloseButton" Focusable="False" Classes="caption close" Content="&#xE8BB;" AutomationProperties.Name="Close" />
      </StackPanel>
      <Grid x:Name="TopBarContent" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="14" Margin="20,0,16,0">
        <!-- The logo: the waveform G and the name in its drawn letters -->
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" AutomationProperties.Name="GZJam">
          <c:LogoMark Width="24" Height="24" />
          <c:Wordmark Height="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
          <TextBlock Classes="fader-label" Text="CLOCK" VerticalAlignment="Center" />
          <Border Classes="readout-window" MinHeight="28">
            <TextBlock Classes="mono" Text="{Binding Clock}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Border>
        </StackPanel>

        <!-- Short-lived messages, e.g. why a load was refused -->
        <Border Grid.Column="2" Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#66F5A524" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}">
          <!-- Narrow, a long notice is trimmed rather than pushing its Undo out of sight -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Deck2Brush}" FontSize="12.5" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Notice}" />
            <Button x:Name="NoticeUndoButton" Grid.Column="1" Classes="link" Content="Undo" Click="OnNoticeUndoClick" Margin="0,-3"
                    Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"
                    IsVisible="{Binding NoticeUndo, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Grid>
        </Border>

        <!-- A newer GZJam is out: only at startup, until the room hears music or it's closed -->
        <Border x:Name="NewVersionLine" Grid.Column="2" Classes="hint" Padding="10,1,3,1" HorizontalAlignment="Center"
                VerticalAlignment="Center" IsVisible="{Binding ShowsNewVersion}">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <TextBlock Text="{Binding NewVersionText}" Classes="muted" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,4,0" />
            <Button x:Name="NewVersionLink" Classes="link" Content="What's new · Download" Click="OnNewVersionClick"
                    Foreground="{StaticResource AccentBrush}" ToolTip.Tip="Opens the release page in your browser" />
            <Button x:Name="NewVersionDismiss" Classes="link" Padding="6" Click="OnNewVersionDismissClick"
                    ToolTip.Tip="Don't mention this version again">
              <Path Data="{StaticResource IconClose}" Stroke="{StaticResource MutedBrush}" StrokeThickness="2.4"
                    StrokeLineCap="Round" Stretch="Uniform" Width="8" Height="8" />
            </Button>
          </StackPanel>
        </Border>

        <!-- Scanning, then analyzing (waveforms, silence, BPM) -->
        <StackPanel x:Name="BackgroundStatusPanel" Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                    IsVisible="{Binding BackgroundStatus, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="Transparent" ToolTip.Tip="{Binding BackgroundTip}">
          <TextBlock Classes="muted" FontSize="12" Text="{Binding BackgroundStatus}" VerticalAlignment="Center" />
          <ProgressBar Width="100" MinWidth="100" Height="4" Minimum="0" Maximum="100"
                       Value="{Binding BackgroundPercent}" Foreground="{StaticResource AccentBrush}" />
        </StackPanel>

        <!-- Outputs; click either to change them -->
        <Button Grid.Column="4" Classes="output-chip" Click="OnOutputChipClick" ToolTip.Tip="Speaker output (click to change)">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Border Classes="led green on" IsVisible="{Binding HasMainOutput}" />
            <Border Classes="led red on" IsVisible="{Binding !HasMainOutput}" />
            <TextBlock Classes="fader-label" Text="MAIN" VerticalAlignment="Center" />
            <TextBlock Text="{Binding MainOutputName}" FontSize="12" FontWeight="SemiBold" MaxWidth="200" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Grid.Column="5" Classes="output-chip" Click="OnOutputChipClick" ToolTip.Tip="Headphone output (click to change)">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Border Classes="led green on" IsVisible="{Binding HasCueOutput}" />
            <Border Classes="led amber on" IsVisible="{Binding !HasCueOutput}" />
            <TextBlock Classes="fader-label" Text="CUE" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CueOutputName}" FontSize="12" FontWeight="SemiBold" MaxWidth="200" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>

        <!-- The booth, only once one is chosen -->
        <Button x:Name="BoothChip" Grid.Column="6" Classes="output-chip" Click="OnOutputChipClick" ToolTip.Tip="Booth output (click to change)"
                IsVisible="{Binding ShowsBoothOutput}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Border Classes="led green on" IsVisible="{Binding HasBoothOutput}" />
            <Border Classes="led amber on" IsVisible="{Binding !HasBoothOutput}" />
            <TextBlock Classes="fader-label" Text="BOOTH" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BoothOutputName}" FontSize="12" FontWeight="SemiBold" MaxWidth="200" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>

        <!-- The decks' size: full, compact (Ctrl/Cmd+D) or hidden behind one line (Ctrl/Cmd+Shift+D),
             the lit key the size now (#171). Also Settings › Decks and the grip under the decks. -->
        <Border x:Name="DeckSizeSwitch" Grid.Column="7" Classes="deck-size">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="FullDecksButton" Classes="deck-size" Classes.on="{Binding IsFullDecks}"
                    Command="{Binding SetDeckSizeCommand}" CommandParameter="{x:Static vm:DeckSize.Full}" ToolTip.Tip="{Binding FullDecksTip}">
              <Path Data="{StaticResource IconDecksFull}" Stroke="{Binding $parent[Button].Foreground}" />
            </Button>
            <Button x:Name="CompactDecksButton" Classes="deck-size" Classes.on="{Binding IsCompactSize}"
                    Command="{Binding SetDeckSizeCommand}" CommandParameter="{x:Static vm:DeckSize.Compact}" ToolTip.Tip="{Binding CompactDecksTip}">
              <Path Data="{StaticResource IconDecksCompact}" Stroke="{Binding $parent[Button].Foreground}" />
            </Button>
            <Button x:Name="HiddenDecksButton" Classes="deck-size" Classes.on="{Binding DecksHidden}"
                    Command="{Binding SetDeckSizeCommand}" CommandParameter="{x:Static vm:DeckSize.Hidden}" ToolTip.Tip="{Binding HiddenDecksTip}">
              <Path Data="{StaticResource IconDecksHidden}" Stroke="{Binding $parent[Button].Foreground}" />
            </Button>
          </StackPanel>
        </Border>

        <Button x:Name="SettingsButton" Grid.Column="8" Classes="icon-button" ToolTip.Tip="{Binding SettingsTip}" Click="OnSettingsClick">
          <PathIcon Data="{StaticResource IconGear}" Width="16" Height="16" />
        </Button>

        <!-- In full screen, in place of the window's own buttons: the way out by mouse or finger (#155) -->
        <Button x:Name="ExitFullScreenButton" Grid.Column="9" Classes="icon-button" Click="OnExitFullScreenClick" IsVisible="False"
                ToolTip.Tip="Leave full screen (F11)" AutomationProperties.Name="Leave full screen">
          <Path Data="{StaticResource IconExitFullScreen}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="15" Height="15" />
        </Button>
      </Grid>
      </DockPanel>
    </Border>

  <Grid RowDefinitions="Auto,Auto,*" Margin="16,4,16,16" RowSpacing="12">

    <!-- Audio failed to load: say so plainly; the library still works -->
    <Border Grid.Row="0" Classes="hint" BorderBrush="{StaticResource OnAirBrush}"
            IsVisible="{Binding AudioError, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding AudioError}" Foreground="{StaticResource OnAirBrush}" TextWrapping="Wrap" />
    </Border>

    <!-- ───────────── Hidden decks: one line for what the room hears and what's next (#164) ───────────── -->
    <Border x:Name="AirLine" Grid.Row="1" Classes="panel air-line" IsVisible="{Binding DecksHidden}" ClipToBounds="True">
      <Panel>
        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,*,Auto" ColumnSpacing="14" Margin="12,8,8,8">
          <!-- The deck the room hears: its own play key (two taps on air, if chosen), so the room
               can always be paused without bringing the decks back -->
          <Button x:Name="AirPlayButton" Classes="play" Classes.playing="{Binding AirLine?.Now?.IsPlaying, TargetNullValue=False}"
                  Classes.armed="{Binding AirLine?.Now?.IsPauseArmed, TargetNullValue=False}" Command="{Binding AirLine?.Now?.TogglePlayCommand}"
                  IsEnabled="{Binding AirLine?.HasNow}" ToolTip.Tip="{Binding AirLine?.Now?.PlayTip}"
                  Width="34" Height="34" VerticalAlignment="Center">
            <Panel>
              <PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12" IsVisible="{Binding !AirLine?.Now?.IsPlaying, TargetNullValue=False}" />
              <PathIcon Data="{StaticResource IconPause}" Width="11" Height="11" IsVisible="{Binding AirLine?.Now?.IsPlaying, TargetNullValue=False}" />
            </Panel>
          </Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" IsVisible="{Binding AirLine?.HasNow}">
            <TextBlock x:Name="AirDeckName" Classes="deck-name" Text="{Binding AirLine?.Now?.Label, StringFormat='DECK {0}'}" />
            <TextBlock Classes="status" Classes.air="{Binding AirLine?.Now?.IsOnAir, TargetNullValue=False}" Text="{Binding AirLine?.Now?.Status}" FontSize="10" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="AirTitle" Text="{Binding AirLine?.Now?.Title, FallbackValue='Nothing on air', TargetNullValue='Nothing on air'}" FontSize="14" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="muted" Text="{Binding AirLine?.Now?.Track?.Artist, FallbackValue=''}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Border Grid.Column="3" Classes="hint" VerticalAlignment="Center"
                  IsVisible="{Binding AirLine?.Now?.Hint, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
            <TextBlock Text="{Binding AirLine?.Now?.Hint}" />
          </Border>
          <TextBlock x:Name="AirTimeLeft" Grid.Column="4" Classes="mono readout-text" Classes.blink="{Binding AirLine?.Now?.IsReadoutDimmed, TargetNullValue=False}"
                     Text="{Binding AirLine?.Now?.TimeLeftText}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="5" VerticalAlignment="Center" Spacing="2" Margin="10,0,0,0">
            <TextBlock x:Name="AirNextFrom" Classes="label" Text="{Binding AirLine?.NextFrom}" />
            <TextBlock x:Name="AirNextText" Text="{Binding AirLine?.NextText}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button x:Name="ShowDecksButton" Grid.Column="6" Classes="icon-button" Command="{Binding ToggleHideDecksCommand}"
                  ToolTip.Tip="{Binding HideDecksTip}" VerticalAlignment="Center">
            <Path Data="{StaticResource IconDecksBigger}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="16" Height="16" />
          </Button>
        </Grid>
        <!-- How far into the song the room is, the width of the line (#165) -->
        <c:AirBar x:Name="AirLineBar" Classes="air-line-bar" Progress="{Binding AirLine?.Now?.AirProgress, TargetNullValue=0}"
                  Fill="{StaticResource OnAirBrush}" IsVisible="{Binding AirLine?.Now?.IsOnAir, TargetNullValue=False}" IsHitTestVisible="False" />
      </Panel>
    </Border>

    <!-- ───────────── Decks + mixer ───────────── -->
    <Grid x:Name="DecksRow" Grid.Row="1" ColumnDefinitions="*,212,*" ColumnSpacing="12">
      <!-- The row is as tall as the decks or the mixer column need, whichever is more. With four
           decks, 3 sits under 1 and 4 under 2, all four the same height (MainWindow.ApplyDeckLayout). -->
      <Grid x:Name="LeftDecks" RowDefinitions="*,Auto">
        <v:DeckView x:Name="Deck1View" Label="1" Accent="{StaticResource Deck1Brush}"
                    DataContext="{Binding Deck1}" />
        <v:DeckView x:Name="Deck3View" Grid.Row="1" Label="3" Accent="{StaticResource Deck3Brush}"
                    IsVisible="False" DataContext="{Binding Deck3}" />
      </Grid>

      <!-- The mixer strip: the speakers' meter and limit light, main and phones faders, the phones
           mix, the crossfader -->
      <Border x:Name="MixerPanel" Grid.Column="1" Classes="panel" Padding="14,12">
        <Grid RowDefinitions="*,Auto,Auto" RowSpacing="6" DataContext="{Binding Mixer}" x:DataType="vm:MixerViewModel">
          <Grid ColumnDefinitions="44,*,*" RowDefinitions="*,Auto" RowSpacing="5">
            <c:LevelMeter x:Name="MainMeter" IsMono="{Binding IsMono}" Left="{Binding LevelLeft}" Right="{Binding LevelRight}"
                          Margin="0,6,0,6"
                          ToolTip.Tip="What the speakers are playing. One column: mono (change in Settings)." />
            <c:Fader x:Name="MainVolumeFader" Grid.Column="1" Classes="volume" Value="{Binding MainVolume}"
                     ToolTip.Tip="{Binding MainVolumeTip}" />
            <c:Fader x:Name="CueVolumeFader" Grid.Column="2" Classes="volume" Value="{Binding CueVolume}"
                     ToolTip.Tip="{Binding CueVolumeTip}" />

            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left"
                        ToolTip.Tip="Lights when the speakers are too loud and the limiter is holding them down. Turn down a deck or the main volume.">
              <Border x:Name="LimitLed" Classes="led red" Classes.on="{Binding IsLimiting}" Width="6" Height="6" />
              <TextBlock Classes="fader-label" Text="LIMIT" />
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="fader-label" Text="MAIN" HorizontalAlignment="Center" />
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="fader-label" Text="PHONES" HorizontalAlignment="Center" />
          </Grid>

          <!-- The phones mix: what the headphones hear, from what's cued to what the room hears -->
          <Grid x:Name="PhonesMixRow" Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding PhonesMixTip}">
            <TextBlock Classes="fader-label" Text="CUE" />
            <TextBlock Grid.Column="1" Classes="fader-label" Text="PHONES MIX" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="fader-label" Text="MAIN" />
            <c:CrossfaderControl x:Name="PhonesMixFader" Grid.Row="1" Grid.ColumnSpan="3" TickCount="5"
                                 Height="{DynamicResource PhonesMixHeight}" IndexBrush="{StaticResource Deck2Brush}"
                                 Value="{Binding PhonesMix}" />
          </Grid>

          <!-- The crossfader, and under it the keys that glide it to a side. Compact decks: all on one
               row, the keys either side of the crossfader (MainWindow.ApplyDeckLayout). -->
          <Grid x:Name="CrossfaderRows" Grid.Row="2" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="6">
            <c:CrossfaderControl x:Name="Crossfader" Grid.ColumnSpan="3" Height="{DynamicResource CrossfaderHeight}" Value="{Binding Crossfader}"
                                 ToolTip.Tip="Crossfader: fades the room between the left deck(s) and the right" />
            <!-- The side the room hears has its light on. With four decks each carries both of that side's numbers. -->
            <Button x:Name="LeftSideButton" Grid.Row="1" Classes="hw side" Command="{Binding SnapTo1Command}" ToolTip.Tip="{Binding LeftTip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Classes="led red" Classes.on="{Binding IsDeck1Live}" />
                <TextBlock Text="1" Foreground="{StaticResource Deck1Brush}" />
                <TextBlock Text="3" Foreground="{StaticResource Deck3Brush}" IsVisible="{Binding IsFourDecks}" />
              </StackPanel>
            </Button>
            <TextBlock x:Name="LiveLabel" Grid.Row="1" Grid.Column="1" Classes="fader-label" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="{Binding LiveText}" />
            <Button x:Name="RightSideButton" Grid.Row="1" Grid.Column="2" Classes="hw side" Command="{Binding SnapTo2Command}" ToolTip.Tip="{Binding RightTip}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Classes="led red" Classes.on="{Binding IsDeck2Live}" />
                <TextBlock Text="2" Foreground="{StaticResource Deck2Brush}" />
                <TextBlock Text="4" Foreground="{StaticResource Deck4Brush}" IsVisible="{Binding IsFourDecks}" />
              </StackPanel>
            </Button>
          </Grid>
        </Grid>
      </Border>

      <Grid x:Name="RightDecks" Grid.Column="2" RowDefinitions="*,Auto">
        <v:DeckView x:Name="Deck2View" Classes="meter-left" Label="2" Accent="{StaticResource Deck2Brush}"
                    DataContext="{Binding Deck2}" />
        <v:DeckView x:Name="Deck4View" Grid.Row="1" Classes="meter-left" Label="4" Accent="{StaticResource Deck4Brush}"
                    IsVisible="False" DataContext="{Binding Deck4}" />
      </Grid>
    </Grid>

    <!-- Drag up for smaller decks and more songs, further for hidden ones; down for bigger (or tap): MainWindow.Decks -->
    <Border x:Name="DeckGrip" Grid.Row="1" Classes="deck-grip" Margin="0,0,0,-12"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" ToolTip.Tip="Drag up for smaller decks, further for one line; down for bigger. A tap switches compact.">
      <Border Classes="deck-grip-bar" />
    </Border>

    <!-- ───────────── Library ───────────── -->
    <!-- The side panels can be dragged wider or narrower, or folded into a strip that a tap opens
         again (MainWindow.Panes) -->
    <Grid x:Name="PanesGrid" Grid.Row="2" ColumnDefinitions="260,12,*,12,320">
      <Button x:Name="LibraryStrip" Classes="fold-strip" IsVisible="False" Click="OnLibraryStripClick"
              ToolTip.Tip="Show the library">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
          <Path Classes="strip-chevron" Data="M 1,0 10,10 l -9,10 -1,-1 L 8,10 -0,1 Z" />
          <LayoutTransformControl>
            <LayoutTransformControl.LayoutTransform>
              <RotateTransform Angle="90" />
            </LayoutTransformControl.LayoutTransform>
            <TextBlock Classes="label" Text="LIBRARY" />
          </LayoutTransformControl>
        </StackPanel>
      </Button>
      <Button x:Name="QueueStrip" Grid.Column="4" Classes="fold-strip" IsVisible="False" Click="OnQueueStripClick"
              ToolTip.Tip="Show the queue and History">
        <StackPanel Spacing="12" HorizontalAlignment="Center">
          <Path Classes="strip-chevron" Data="M 9,0 10,1 2,10 10,19 9,20 0,10 Z" />
          <LayoutTransformControl>
            <LayoutTransformControl.LayoutTransform>
              <RotateTransform Angle="90" />
            </LayoutTransformControl.LayoutTransform>
            <TextBlock Classes="label" Text="QUEUE" />
          </LayoutTransformControl>
        </StackPanel>
      </Button>

      <!-- Folder tree, and the playlists under it. Folded, the tree shows only the music folders
           and the playlists take the rest; otherwise the playlists are as tall as the grip on their
           header was dragged (MainWindow.Playlists, #163). -->
      <Border x:Name="LibraryPanel" Classes="panel">
        <Grid x:Name="LibraryColumn" RowDefinitions="Auto,*,Auto">
          <Border Classes="panel-header" Padding="14,0,6,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <Button x:Name="FoldFoldersButton" Classes="link" Margin="-6,0,0,0" HorizontalAlignment="Left"
                      Command="{Binding Library.ToggleFoldFoldersCommand}" ToolTip.Tip="{Binding Library.FoldTip}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path x:Name="FoldChevron" Classes="fold-chevron" Classes.folded="{Binding Library.AreFoldersFolded}" />
                  <TextBlock Classes="label" Text="LIBRARY" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Classes="link" Content="+ Folder" Click="OnAddFolderClick"
                      ToolTip.Tip="Add a music folder to the library" />
              <!-- Fold the whole panel into a strip at the window's edge, for more song list -->
              <Button x:Name="FoldLibraryButton" Grid.Column="2" Classes="link panel-fold" Click="OnFoldLibraryClick"
                      ToolTip.Tip="Fold the library panel away">
                <Path Classes="strip-chevron" Data="M 9,0 10,1 2,10 10,19 9,20 0,10 Z" />
              </Button>
            </Grid>
          </Border>
          <c:FolderTreeView x:Name="FolderTree" Grid.Row="1" Classes="folders" Margin="4,6"
                    ItemsSource="{Binding Library.Roots}"
                    SelectedItem="{Binding Library.SelectedFolder, Mode=TwoWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <c:FolderTreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:FolderNodeViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </Style>
            </c:FolderTreeView.Styles>
            <c:FolderTreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" Background="Transparent">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Rescan" Command="{Binding RescanCommand}" />
                      <MenuItem Header="Read all tags again" Command="{Binding ReadAllTagsAgainCommand}" />
                      <MenuItem Header="Open folder" Command="{Binding OpenInFileManagerCommand}" />
                      <Separator IsVisible="{Binding IsRoot}" />
                      <MenuItem Header="Remove from library" Command="{Binding RemoveFromLibraryCommand}"
                                IsVisible="{Binding IsRoot}"
                                ToolTip.Tip="Forget this folder. Your files are not touched." />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="#8F9BB0" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Grid.Column="2" Classes="dim" Text="{Binding CountText}" FontSize="11"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                </Grid>
              </TreeDataTemplate>
            </c:FolderTreeView.ItemTemplate>
          </c:FolderTreeView>
          <!-- Playlists: sets planned in order, under the folders -->
          <DockPanel x:Name="PlaylistsSection" Grid.Row="2">
            <Border DockPanel.Dock="Top" Classes="panel-header playlists-header">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="label" Text="PLAYLISTS" />
                <Button x:Name="NewPlaylistButton" Grid.Column="1" Classes="link" Content="+ New" Click="OnNewPlaylistClick"
                        ToolTip.Tip="Plan a set: a playlist of songs in order" />
              </Grid>
            </Border>
            <ListBox x:Name="PlaylistList" Classes="playlists" Margin="4,4,4,6"
                     ItemsSource="{Binding Library.Playlists}" SelectedItem="{Binding Library.SelectedPlaylist, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="lib:PlaylistInfo">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" Background="Transparent">
                    <Grid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Add to queue" Click="OnPlaylistItemToQueueClick" />
                        <Separator />
                        <MenuItem Header="Rename…" Click="OnRenamePlaylistItemClick" />
                        <MenuItem Header="Delete…" Click="OnDeletePlaylistItemClick" />
                      </ContextMenu>
                    </Grid.ContextMenu>
                    <Path Data="{StaticResource IconPlaylist}" Stroke="#8F9BB0" StrokeThickness="2" StrokeLineCap="Round"
                          Stretch="Uniform" Width="13" Height="11" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               ToolTip.Tip="{Binding Name}" />
                    <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Count}" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <!-- Drag up for more playlists, down for more folders: on the playlists' top edge -->
          <Border x:Name="PlaylistsGrip" Grid.Row="2" Classes="deck-grip playlists-grip"
                  IsVisible="{Binding !Library.AreFoldersFolded}"
                  ToolTip.Tip="Drag up for more playlists, down for more folders">
            <Border Classes="deck-grip-bar" />
          </Border>
        </Grid>
      </Border>

      <!-- Drag to share the room between the panels: a grip shows where (a finger gets no pointer change) -->
      <Border x:Name="TreeSplitterGrip" Grid.Column="1" Classes="splitter-grip" />
      <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Classes="panes" Background="Transparent" ResizeDirection="Columns"
                    ToolTip.Tip="Drag to make the panels either side wider or narrower" />

      <!-- Search + results -->
      <Border Grid.Column="2" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <Border Classes="panel-header" Height="56" Padding="12,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
              <Panel>
                <TextBox x:Name="SearchBox" Classes="search" Text="{Binding Library.SearchText}"
                         PlaceholderText="Search, or filter: bpm:130-150  artist:basie  rating:yes" />
                <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource MutedBrush}" StrokeThickness="2.2"
                      StrokeLineCap="Round" Stretch="Uniform" Width="14" Height="14"
                      HorizontalAlignment="Left" Margin="12,0" IsHitTestVisible="False" />
                <Button Classes="link" HorizontalAlignment="Right" Margin="0,0,5,0" Padding="6"
                        Command="{Binding Library.ClearSearchCommand}" ToolTip.Tip="Clear search (Esc)"
                        IsVisible="{Binding Library.SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <Path Data="{StaticResource IconClose}" Stroke="{StaticResource MutedBrush}" StrokeThickness="2.4"
                        StrokeLineCap="Round" Stretch="Uniform" Width="9" Height="9" />
                </Button>
              </Panel>
              <!-- BPM filter by tap: near a deck's tempo, or a range. Writes bpm: into the search text. -->
              <Button x:Name="BpmFilterButton" Grid.Column="1" Classes="bpm-filter" Classes.on="{Binding Library.HasBpmFilter}"
                      VerticalAlignment="Center" ToolTip.Tip="Show tracks near a deck's tempo, or in a tempo range">
                <TextBlock Classes="mono" Text="{Binding Library.BpmFilterLabel}" FontSize="12" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft" />
                </Button.Flyout>
              </Button>
              <!-- Label filter by tap: writes label: into the search text -->
              <Button x:Name="LabelFilterButton" Grid.Column="2" Classes="bpm-filter" Classes.on="{Binding Library.HasLabelFilter}"
                      VerticalAlignment="Center" ToolTip.Tip="Show songs with a label (Slow, Requests, …)">
                <TextBlock Text="{Binding Library.LabelFilterLabel}" FontSize="12" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft" />
                </Button.Flyout>
              </Button>
              <Border Grid.Column="3" Classes="chip" IsVisible="{Binding Library.HasScope}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Library.ScopeText}" FontSize="12" Foreground="{StaticResource TextBrush}"
                             VerticalAlignment="Center" MaxWidth="340" TextTrimming="CharacterEllipsis" />
                  <Button Classes="link" Padding="5" Command="{Binding Library.ClearScopeCommand}"
                          ToolTip.Tip="Search the whole library">
                    <Path Data="{StaticResource IconClose}" Stroke="{StaticResource MutedBrush}" StrokeThickness="2.4"
                          StrokeLineCap="Round" Stretch="Uniform" Width="8" Height="8" />
                  </Button>
                </StackPanel>
              </Border>
              <TextBlock Grid.Column="4" Classes="muted" FontSize="12" VerticalAlignment="Center"
                         Text="{Binding Library.ResultSummary}" />
            </Grid>
          </Border>

          <!-- A playlist open in the song list: its name, how long, and adding it to the queue -->
          <Border x:Name="PlaylistBar" Grid.Row="1" Classes="playlist-bar" IsVisible="{Binding Library.IsPlaylistOpen}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
              <Path Data="{StaticResource IconPlaylist}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                    StrokeLineCap="Round" Stretch="Uniform" Width="15" Height="13" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="PlaylistNameText" Text="{Binding Library.PlaylistName}" FontSize="14"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PlaylistSummaryText" Classes="muted" FontSize="11.5" Text="{Binding Library.PlaylistSummary}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Button x:Name="PlaylistToQueueButton" Grid.Column="2" Classes="eq-action" Click="OnPlaylistToQueueClick"
                      ToolTip.Tip="Add every song in this playlist to the end of the queue" Content="Add to queue" />
              <Button x:Name="PlaylistMoreButton" Grid.Column="3" Classes="eq-action" Content="⋯" Padding="10,5"
                      ToolTip.Tip="Rename or delete this playlist">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem Header="Rename…" Click="OnRenameOpenPlaylistClick" />
                    <MenuItem Header="Delete…" Click="OnDeleteOpenPlaylistClick" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>

          <DataGrid x:Name="TrackGrid" Grid.Row="2" Classes="tracks"
                    ItemsSource="{Binding Library.Results}"
                    IsReadOnly="True" SelectionMode="Extended"
                    CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="38" CanUserResize="False" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="lib:Track">
                    <Button Classes="row-icon" Click="OnPreviewTrackClick" ToolTip.Tip="Preview in headphones"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path Data="{StaticResource IconHeadphones}" Stroke="{Binding $parent[Button].Foreground}"
                            StrokeThickness="2.2" Stretch="Uniform" Width="14" Height="13" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- Rating: tap to cycle unrated, ♥, broken heart -->
              <DataGridTemplateColumn Header="♥" Width="34" CanUserResize="False" SortMemberPath="Rating">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="lib:Track">
                    <Button Classes="row-icon" Padding="4" Click="OnRatingCellClick" HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip.Tip="Would you play this for a dance? Tap: ♥ yes, then broken heart: no, then unrated.">
                      <c:RatingIcon Rating="{Binding Rating}" Width="15" Height="15" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- Album art: hidden to start with, since an album's songs all share one picture -->
              <DataGridTemplateColumn Header="Art" Width="34" CanUserResize="False" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="lib:Track">
                    <c:AlbumArt Width="22" Height="22" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                SongPath="{Binding Path}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Title" Width="2*" MinWidth="140" SortMemberPath="DisplayTitle">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="lib:Track">
                    <!-- The title keeps at least 100 px; labels get what's left, clipped at the edge. In an open
                         playlist, its number in the playlist comes first. -->
                    <Grid ColumnSpacing="6" Background="Transparent" ClipToBounds="True">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="100" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Classes="dim mono playlist-number" Text="{Binding PlaylistNumber}" FontSize="11"
                                 IsVisible="{Binding PlaylistNumber, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <c:LabelChips Grid.Column="2" ItemsSource="{Binding Labels}" MaxWidth="140" HorizontalAlignment="Left" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Artist" Width="1.3*" MinWidth="100" x:DataType="lib:Track"
                                  Binding="{Binding Artist, Mode=OneWay}" />
              <DataGridTextColumn Header="Album" Width="1.3*" MinWidth="100" x:DataType="lib:Track"
                                  Binding="{Binding Album, Mode=OneWay}" />
              <DataGridTextColumn Header="Genre" Width="88" x:DataType="lib:Track"
                                  Binding="{Binding Genre, Mode=OneWay}" />
              <DataGridTextColumn Header="Year" Width="72" CellStyleClasses="num" x:DataType="lib:Track"
                                  Binding="{Binding Year, Mode=OneWay}" />
              <DataGridTextColumn Header="BPM" Width="72" CellStyleClasses="num" x:DataType="lib:Track"
                                  Binding="{Binding Bpm, Mode=OneWay, Converter={x:Static app:Converters.Bpm}}" SortMemberPath="Bpm" />
              <!-- Energy: tap to cycle unset, low, medium, high -->
              <DataGridTemplateColumn Header="Energy" Width="84" MinWidth="44" SortMemberPath="Energy">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="lib:Track">
                    <Button Classes="row-icon" Padding="8,4" Click="OnEnergyCellClick" HorizontalAlignment="Center" VerticalAlignment="Center"
                            ToolTip.Tip="Energy. Tap: low, medium, high, then unset.">
                      <c:EnergyIcon Energy="{Binding Energy}" Width="16" Height="13" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Played" Width="86" CellStyleClasses="num" x:DataType="lib:Track"
                                  Binding="{Binding LastPlayedUtc, Mode=OneWay, Converter={x:Static app:Converters.Ago}}" SortMemberPath="LastPlayedUtc" />
              <DataGridTextColumn Header="Time" Width="76" CellStyleClasses="num" x:DataType="lib:Track"
                                  Binding="{Binding Duration, Mode=OneWay, Converter={x:Static app:Converters.Duration}}" SortMemberPath="Duration" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
              <ContextMenu x:Name="TrackMenu">
                <MenuItem Header="Add to queue" InputGesture="Enter" Click="OnAddToQueueClick" />
                <MenuItem Header="Play next" InputGesture="Shift+Enter" Click="OnPlayNextClick" />
                <MenuItem x:Name="TrackFromHereMenuItem" Header="Add to queue from here" Click="OnPlaylistFromHereClick"
                          ToolTip.Tip="This song and the rest of the playlist after it" />
                <Separator />
                <MenuItem Header="Preview in headphones" InputGesture="Space" Click="OnPreviewSelectedClick" />
                <MenuItem x:Name="TrackLoad1" Header="Load to Deck 1" Tag="0" Click="OnLoadSelectedToDeckClick" />
                <MenuItem x:Name="TrackLoad2" Header="Load to Deck 2" Tag="1" Click="OnLoadSelectedToDeckClick" />
                <MenuItem x:Name="TrackLoad3" Header="Load to Deck 3" Tag="2" Click="OnLoadSelectedToDeckClick" />
                <MenuItem x:Name="TrackLoad4" Header="Load to Deck 4" Tag="3" Click="OnLoadSelectedToDeckClick" />
                <Separator />
                <MenuItem Header="Show in folder tree" Click="OnShowInTreeClick" />
                <MenuItem x:Name="RevealMenuItem" Header="Show in Explorer" Click="OnRevealFileClick" />
                <Separator />
                <MenuItem x:Name="TrackRatingMenu" Header="Rating" />
                <MenuItem x:Name="TrackLabelsMenu" Header="Labels" />
                <MenuItem x:Name="TrackEnergyMenu" Header="Energy" />
                <MenuItem x:Name="TrackBpmMenu" Header="BPM" />
                <Separator />
                <MenuItem x:Name="TrackPlaylistsMenu" Header="Add to playlist" />
                <MenuItem x:Name="RemoveFromPlaylistMenuItem" Header="Remove from playlist" InputGesture="Delete"
                          Click="OnRemoveFromPlaylistClick" ToolTip.Tip="Take it out of this playlist. The file isn't touched." />
              </ContextMenu>
            </DataGrid.ContextMenu>
          </DataGrid>

          <!-- Where songs dragged within a playlist would land (MainWindow.Playlists) -->
          <Border x:Name="PlaylistDropLine" Grid.Row="2" Classes="playlist-drop-line" IsVisible="False" Margin="8,0" />

          <!-- Empty states -->
          <StackPanel Grid.Row="2" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="{Binding Library.HasNoRoots}">
            <TextBlock Text="Add your music folder to get started" FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap"
                       Text="GZJam shows your folders exactly as they are on disk, and never moves or renames your files." />
            <Button Content="Add folder…" HorizontalAlignment="Center" Padding="16,8" Click="OnAddFolderClick"
                    Background="{StaticResource AccentBrush}" Foreground="White" />
          </StackPanel>
          <TextBlock Grid.Row="2" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Text="{Binding Library.EmptyMessage}" IsVisible="{Binding Library.HasNoResults}" />

          <!-- Headphone preview -->
          <Border Grid.Row="3" Classes="preview-bar" DataContext="{Binding Preview}" x:DataType="vm:PreviewViewModel"
                  IsVisible="{Binding IsActive, FallbackValue=False}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
              <Border Classes="preview-edge" Grid.RowSpan="1" />
              <Path Data="{StaticResource IconHeadphones}" Stroke="{StaticResource Deck2Brush}" StrokeThickness="2.2"
                    Stretch="Uniform" Width="16" Height="15" VerticalAlignment="Center" Margin="2,0,0,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="260">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted" FontSize="11" Text="Previewing in headphones" />
              </StackPanel>
              <c:SeekBar x:Name="PreviewSeek" Grid.Column="2" Height="28" Progress="{Binding Progress}"
                         Fill="{StaticResource Deck2Brush}" CornerRadius="3" />
              <TextBlock Grid.Column="3" Classes="muted mono" FontSize="12" Text="{Binding TimeText}" VerticalAlignment="Center" />
              <Button Grid.Column="4" Classes="hw small" Content="STOP" Command="{Binding StopCommand}" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Drag to share the room between the panels: a grip shows where (a finger gets no pointer change) -->
      <Border x:Name="QueueSplitterGrip" Grid.Column="3" Classes="splitter-grip" />
      <GridSplitter x:Name="QueueSplitter" Grid.Column="3" Classes="panes" Background="Transparent" ResizeDirection="Columns"
                    ToolTip.Tip="Drag to make the panels either side wider or narrower" />

      <!-- Queue and History -->
      <Border x:Name="QueuePanel" Grid.Column="4" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,*">
          <!-- Auto-play: plays through the queue, alternating decks, with the gap between songs.
               Above the tabs, so its status stays in view on the History tab too. -->
          <Border Classes="autoplay" DataContext="{Binding AutoPlay}" x:DataType="vm:AutoPlayViewModel">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="5">
                <ToggleButton x:Name="AutoPlaySwitch" Classes="hw small" IsChecked="{Binding IsOn}" IsEnabled="{Binding CanToggle}"
                              ToolTip.Tip="{Binding SwitchTip}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Classes="led green" Classes.on="{Binding IsOn}" />
                    <TextBlock Text="AUTO-PLAY" />
                  </StackPanel>
                </ToggleButton>
                <TextBlock Grid.Column="2" Classes="fader-label" Text="GAP" VerticalAlignment="Center" Margin="0,0,3,0"
                           ToolTip.Tip="Silence between songs when auto-play moves to the next one" />
                <Button Grid.Column="3" Classes="hw step" Content="−" Command="{Binding GapDownCommand}" />
                <Border Grid.Column="4" Classes="readout-window" MinWidth="52">
                  <TextBlock Classes="mono" Text="{Binding GapText}" FontWeight="SemiBold" FontSize="12.5"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button Grid.Column="5" Classes="hw step" Content="+" Command="{Binding GapUpCommand}" />

                <!-- For classes and practice nights: fade each song after a while, wait for the
                     teacher between songs, stop at a set time (#98, #100) -->
                <Button x:Name="AutoPlayOptionsButton" Grid.Column="6" Classes="hw step" Content="⋯" FontSize="14"
                        ToolTip.Tip="Auto-play options: fade each song after a while, wait for you between songs, stop at a set time">
                  <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="panel" Opening="OnAutoPlayOptionsOpening">
                      <StackPanel Width="270" Spacing="12">
                        <TextBlock Classes="label" Text="AUTO-PLAY OPTIONS" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="5">
                          <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Classes="setting" Text="Fade after" />
                            <TextBlock Classes="setting-help" Text="Each song, for classes and practice" />
                          </StackPanel>
                          <Button x:Name="FadeAfterDownButton" VerticalAlignment="Center" Grid.Column="1" Classes="hw step" Content="−" Command="{Binding FadeAfterDownCommand}" />
                          <Border Grid.Column="2" Classes="readout-window" MinWidth="50" VerticalAlignment="Center">
                            <TextBlock Classes="mono" Text="{Binding FadeAfterText}" FontWeight="SemiBold" FontSize="12.5"
                                       Classes.muted="{Binding !IsFadeAfterOn}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Border>
                          <Button x:Name="FadeAfterUpButton" VerticalAlignment="Center" Grid.Column="3" Classes="hw step" Content="+" Command="{Binding FadeAfterUpCommand}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Classes="setting" Text="Wait for me after each song" />
                            <TextBlock Classes="setting-help" TextWrapping="Wrap" Text="The next song is lined up; press play when you're ready" />
                          </StackPanel>
                          <ToggleButton x:Name="WaitAfterEachSwitch" Grid.Column="1" Classes="switch" VerticalAlignment="Center" IsChecked="{Binding WaitAfterEach}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                          <StackPanel Spacing="1" VerticalAlignment="Center">
                            <TextBlock Classes="setting" Text="Stop at" />
                            <TextBlock Classes="setting-help" TextWrapping="Wrap" Text="The song playing then is the last" />
                          </StackPanel>
                          <ComboBox x:Name="StopAtBox" Grid.Column="1" MinWidth="110" VerticalAlignment="Center"
                                    ItemsSource="{Binding StopChoices}" SelectedItem="{Binding StopChoice}" />
                        </Grid>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <TextBlock Classes="muted" FontSize="11.5" Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock x:Name="AutoPlayOptionsText" Classes="dim" FontSize="11" Text="{Binding OptionsText}" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding OptionsText}"
                         IsVisible="{Binding OptionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Classes="panel-header" Padding="8,0,6,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="4">
              <ToggleButton x:Name="QueueTab" Classes="tab" Content="Queue" IsChecked="{Binding ShowQueue, Mode=OneWay}"
                            Click="OnQueueTabClick" />
              <ToggleButton Grid.Column="1" Classes="tab" Content="History" IsChecked="{Binding ShowHistory, Mode=OneWay}"
                            Click="OnHistoryTabClick" />
              <TextBlock Grid.Column="3" Classes="muted" FontSize="11.5" VerticalAlignment="Center"
                         Text="{Binding Queue.Summary}" IsVisible="{Binding ShowQueue}" />
              <TextBlock Grid.Column="3" Classes="muted" FontSize="11.5" VerticalAlignment="Center"
                         Text="{Binding History.Summary}" IsVisible="{Binding ShowHistory}" />
              <!-- Give the queue the room in the middle, or the song list back (#178): the divider moves
                   left, or right again. The tip names the key (MainWindow.Panes). -->
              <Button x:Name="QueueWideButton" Grid.Column="4" Classes="link panel-fold" Click="OnQueueWideClick">
                <Path Classes="queue-wide" Data="M 0,0 H 1.6 V 12 H 0 Z M 3.5,6 8.3,1.2 9.4,2.3 6.5,5.2 H 15 V 6.8 H 6.5 L 9.4,9.7 8.3,10.8 Z" />
              </Button>
              <!-- Fold the whole panel into a strip at the window's edge, for more song list -->
              <Button x:Name="FoldQueueButton" Grid.Column="5" Classes="link panel-fold" Click="OnFoldQueueClick"
                      ToolTip.Tip="Fold the queue panel away">
                <Path Classes="strip-chevron" Data="M 1,0 10,10 l -9,10 -1,-1 L 8,10 -0,1 Z" />
              </Button>
            </Grid>
          </Border>

          <!-- History: everything the room heard, by session -->
          <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding ShowHistory}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="8,8,8,2">
              <ComboBox x:Name="SessionPicker" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding History.Sessions}" SelectedItem="{Binding History.SelectedSession}"
                        ToolTip.Tip="Pick a session (gig) to look back on" />
              <!-- The session's menu: name it ("Friday Night, Oct 14"), export its set list, delete it -->
              <Button x:Name="SessionMenuButton" Grid.Column="1" Classes="hw small" Content="⋯" MinWidth="40" FontSize="15"
                      IsEnabled="{Binding History.CanRename}" ToolTip.Tip="Name, export or delete this session">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedRight">
                    <MenuItem x:Name="NameSessionItem" Header="Name this session…" Click="OnNameSessionClick" />
                    <MenuItem x:Name="ExportSetListItem" Header="Export set list…" Click="OnExportSetListClick" />
                    <MenuItem x:Name="SessionToPlaylistItem" Header="Save as playlist…" Click="OnSessionToPlaylistClick" />
                    <Separator />
                    <MenuItem x:Name="DeleteSessionItem" Header="Delete this session…" Click="OnDeleteSessionClick" />
                  </MenuFlyout>
                </Button.Flyout>
                <FlyoutBase.AttachedFlyout>
                  <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="panel">
                    <StackPanel Width="240" Spacing="8">
                      <TextBlock Classes="label" Text="SESSION NAME" />
                      <TextBox x:Name="SessionNameBox" PlaceholderText="e.g. Friday Night, Oct 14" KeyDown="OnSessionNameKeyDown" />
                      <Grid ColumnDefinitions="*,8,*">
                        <Button Classes="hw" Content="SAVE" HorizontalAlignment="Stretch" Click="OnSessionNameSaveClick" />
                        <Button Grid.Column="2" Classes="hw" Content="CLEAR" HorizontalAlignment="Stretch" Click="OnSessionNameClearClick"
                                ToolTip.Tip="Go back to the date" />
                      </Grid>
                    </StackPanel>
                  </Flyout>
                </FlyoutBase.AttachedFlyout>
              </Button>
            </Grid>
            <ListBox x:Name="HistoryList" Grid.Row="1" Classes="queue history" ItemsSource="{Binding History.Plays}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:PlayItem">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="10,0,2,0" Background="Transparent">
                    <TextBlock Classes="dim mono" Text="{Binding TimeText}" FontSize="11" VerticalAlignment="Center" MinWidth="58" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,7">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" Text="{Binding Artist}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                      <TextBlock Classes="muted mono" Text="{Binding BpmText}" FontSize="11" />
                      <TextBlock Classes="muted mono" Text="{Binding DurationText}" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="3" Classes="row-icon" Click="OnPreviewHistoryItemClick" ToolTip.Tip="Preview in headphones"
                            VerticalAlignment="Center">
                      <Path Data="{StaticResource IconHeadphones}" Stroke="{Binding $parent[Button].Foreground}"
                            StrokeThickness="2.2" Stretch="Uniform" Width="14" Height="13" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ContextMenu>
                <ContextMenu x:Name="HistoryMenu">
                  <MenuItem Header="Add to queue" Click="OnHistoryAddToQueueClick" />
                  <Separator />
                  <MenuItem Header="Preview in headphones" Click="OnHistoryPreviewClick" />
                  <MenuItem x:Name="HistoryLoad1" Header="Load to Deck 1" Tag="0" Click="OnHistoryLoadToDeckClick" />
                  <MenuItem x:Name="HistoryLoad2" Header="Load to Deck 2" Tag="1" Click="OnHistoryLoadToDeckClick" />
                  <MenuItem x:Name="HistoryLoad3" Header="Load to Deck 3" Tag="2" Click="OnHistoryLoadToDeckClick" />
                  <MenuItem x:Name="HistoryLoad4" Header="Load to Deck 4" Tag="3" Click="OnHistoryLoadToDeckClick" />
                  <Separator />
                  <MenuItem Header="Show in folder tree" Click="OnHistoryShowInTreeClick" />
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>
            <TextBlock Grid.Row="1" Classes="muted" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="24,0" IsHitTestVisible="False"
                       IsVisible="{Binding History.IsEmpty}"
                       Text="Songs appear here once the room has heard them for 30 seconds." />
          </Grid>

          <Panel Grid.Row="2" x:Name="QueueArea" Background="Transparent"
                 IsVisible="{Binding ShowQueue}">
            <ListBox x:Name="QueueList" Classes="queue" ItemsSource="{Binding Queue.Items}" SelectionMode="Multiple">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:QueueItem">
                  <Grid ColumnDefinitions="Auto,20,Auto,*,Auto,Auto" ColumnSpacing="6" Margin="0,0,2,0" Background="Transparent"
                        Opacity="{Binding Track.IsPlayedTonight, Converter={x:Static app:Converters.Dimmed}}">
                    <Border Classes="next-bar" IsVisible="{Binding IsNext}" Grid.ColumnSpan="2" />
                    <!-- Drag handle: on touch, reorder by dragging here so swiping elsewhere scrolls. -->
                    <Border Classes="grip" Background="Transparent" Width="26" Cursor="SizeAll"
                            ToolTip.Tip="Drag to reorder">
                      <TextBlock Classes="dim" Text="⋮⋮" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Classes="dim mono" Text="{Binding Number}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <c:AlbumArt Grid.Column="2" Width="30" Height="30" CornerRadius="2" VerticalAlignment="Center" Margin="2,0,0,0"
                                SongPath="{Binding Track.Path}" />
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,7">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                      <!-- The artist, then the song's labels in what room is left -->
                      <c:PriorityRow Spacing="5">
                        <TextBlock Classes="muted" Text="{Binding Artist}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <c:LabelChips x:Name="QueueLabels" Classes="small" ItemsSource="{Binding Track.Labels}" />
                      </c:PriorityRow>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                      <c:RatingIcon Rating="{Binding Track.Rating}" ShowUnrated="False" Width="12" Height="12" VerticalAlignment="Center" />
                      <c:EnergyIcon Energy="{Binding Track.Energy}" ShowUnset="False" Width="12" Height="10" VerticalAlignment="Center" />
                      <TextBlock Classes="muted mono" Text="{Binding BpmText}" FontSize="11" />
                      <TextBlock Classes="muted mono" Text="{Binding DurationText}" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="5" Classes="row-icon" Click="OnPreviewQueueItemClick" ToolTip.Tip="Preview in headphones"
                            VerticalAlignment="Center">
                      <Path Data="{StaticResource IconHeadphones}" Stroke="{Binding $parent[Button].Foreground}"
                            StrokeThickness="2.2" Stretch="Uniform" Width="14" Height="13" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ContextMenu>
                <ContextMenu x:Name="QueueMenu">
                  <MenuItem Header="Move to top" Click="OnQueueMoveToTopClick" />
                  <MenuItem Header="Remove" InputGesture="Delete" Click="OnQueueRemoveClick" />
                  <Separator />
                  <MenuItem Header="Preview in headphones" Click="OnPreviewQueueSelectedClick" />
                  <MenuItem x:Name="QueueLoad1" Header="Load to Deck 1" Tag="0" Click="OnLoadQueueToDeckClick" />
                  <MenuItem x:Name="QueueLoad2" Header="Load to Deck 2" Tag="1" Click="OnLoadQueueToDeckClick" />
                  <MenuItem x:Name="QueueLoad3" Header="Load to Deck 3" Tag="2" Click="OnLoadQueueToDeckClick" />
                  <MenuItem x:Name="QueueLoad4" Header="Load to Deck 4" Tag="3" Click="OnLoadQueueToDeckClick" />
                  <Separator />
                  <MenuItem x:Name="QueueRatingMenu" Header="Rating" />
                  <MenuItem x:Name="QueueLabelsMenu" Header="Labels" />
                  <MenuItem x:Name="QueueEnergyMenu" Header="Energy" />
                  <MenuItem x:Name="QueueBpmMenu" Header="BPM" />
                  <Separator />
                  <MenuItem Header="Save queue as playlist…" Click="OnQueueToPlaylistClick" />
                  <MenuItem Header="Clear queue" Click="OnQueueClearClick" />
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>

            <TextBlock Classes="muted" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" IsHitTestVisible="False" IsVisible="{Binding Queue.IsEmpty}"
                       Text="Drag tracks here&#10;or right-click › Add to queue" />

            <Border x:Name="QueueDropLine" Height="2" Margin="8,0" VerticalAlignment="Top"
                    Background="{StaticResource AccentBrush}" IsVisible="False" IsHitTestVisible="False" />
          </Panel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
  </DockPanel>

  <!-- Settings, over the dimmed screen; tapping the dimmed part closes it (see MainWindow.Decks.cs). -->
  <Panel x:Name="SettingsOverlay" IsVisible="False">
    <Border x:Name="SettingsDimmer" Background="#A6000000" PointerPressed="OnSettingsDimmerPressed" />
    <v:SettingsPanel x:Name="SettingsPanel" DataContext="{Binding Settings}" MaxWidth="780" MaxHeight="560" Margin="24" />
  </Panel>

  <!-- A track being dragged follows the pointer here (see MainWindow.Drag.cs). -->
  <Canvas x:Name="DragLayer" IsHitTestVisible="False" />
  </Panel>
</Window>
