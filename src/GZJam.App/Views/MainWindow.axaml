<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:GZJam.App"
        xmlns:vm="using:GZJam.App.ViewModels"
        xmlns:v="using:GZJam.App.Views"
        xmlns:lib="using:GZJam.Library"
        xmlns:c="using:GZJam.App.Controls"
        x:Class="GZJam.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GZJam"
        Width="1440" Height="900" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="40,Auto,250,*" Margin="16" RowSpacing="12">

    <!-- ───────────── Top bar ───────────── -->
    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="14" Margin="4,0">
      <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
        <Border Width="26" Height="26" CornerRadius="7">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#22D3EE" Offset="0" />
              <GradientStop Color="#7C5CFF" Offset="0.55" />
              <GradientStop Color="#F5A524" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Text="GZ" FontSize="12" FontWeight="Black" Foreground="#0C0E12"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="GZJam" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
        <TextBlock Classes="label" Text="CLOCK" />
        <TextBlock Classes="mono" Text="{Binding Clock}" FontSize="16" FontWeight="SemiBold" />
      </StackPanel>

      <!-- Short-lived messages, e.g. why a load was refused -->
      <Border Grid.Column="2" Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="#66F5A524" IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding Notice}" Foreground="{StaticResource Deck2Brush}" FontSize="12.5" />
      </Border>

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                  IsVisible="{Binding Library.ScanStatus, Converter={x:Static ObjectConverters.IsNotNull}}">
        <TextBlock Classes="muted" FontSize="12" Text="{Binding Library.ScanStatus}" VerticalAlignment="Center" />
        <ProgressBar Width="120" MinWidth="120" Height="4" Minimum="0" Maximum="100"
                     Value="{Binding Library.ScanPercent}" Foreground="{StaticResource AccentBrush}" />
      </StackPanel>

      <!-- Outputs; click either to change them -->
      <Button Grid.Column="4" Classes="output-chip" Click="OnOutputChipClick" ToolTip.Tip="Speaker output (click to change)">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Width="7" Height="7" Fill="{StaticResource OkBrush}" IsVisible="{Binding HasMainOutput}" />
          <Ellipse Width="7" Height="7" Fill="{StaticResource OnAirBrush}" IsVisible="{Binding !HasMainOutput}" />
          <TextBlock Classes="muted" Text="Main" FontSize="12" />
          <TextBlock Text="{Binding MainOutputName}" FontSize="12" FontWeight="SemiBold" MaxWidth="200" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
      <Button Grid.Column="5" Classes="output-chip" Click="OnOutputChipClick" ToolTip.Tip="Headphone output (click to change)">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <Ellipse Width="7" Height="7" Fill="{StaticResource OkBrush}" IsVisible="{Binding HasCueOutput}" />
          <Ellipse Width="7" Height="7" Fill="{StaticResource Deck2Brush}" IsVisible="{Binding !HasCueOutput}" />
          <TextBlock Classes="muted" Text="Cue" FontSize="12" />
          <TextBlock Text="{Binding CueOutputName}" FontSize="12" FontWeight="SemiBold" MaxWidth="200" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>

      <Button x:Name="SettingsButton" Grid.Column="6" Classes="icon-button" ToolTip.Tip="Settings">
        <PathIcon Data="{StaticResource IconGear}" Width="16" Height="16" />
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <StackPanel Width="340" Spacing="12" Margin="6" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
              <TextBlock Classes="label" Text="AUDIO OUTPUTS" />
              <StackPanel Spacing="4">
                <TextBlock Text="Main (speakers)" FontSize="12" Classes="muted" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding MainDevices}" SelectedItem="{Binding MainDevice}" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Cue (headphones)" FontSize="12" Classes="muted" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CueDevices}" SelectedItem="{Binding CueDevice}" />
              </StackPanel>
              <Button Classes="link" Content="Refresh device list" Command="{Binding RefreshDevicesCommand}" />

              <TextBlock Classes="label" Text="DECK SAFETY" Margin="0,8,0,0" />
              <StackPanel Spacing="4">
                <TextBlock Text="Loading a track onto a playing deck" FontSize="12" Classes="muted" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding LoadChoices}" SelectedItem="{Binding LoadChoice}" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="Pausing a deck the room is hearing" FontSize="12" Classes="muted" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding PauseChoices}" SelectedItem="{Binding PauseChoice}" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Fade-out length (seconds)" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Width="120" Minimum="1" Maximum="30" Increment="1"
                               Value="{Binding FadeOutSeconds}" FormatString="0" />
              </Grid>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </Grid>

    <!-- Audio failed to load: say so plainly; the library still works -->
    <Border Grid.Row="1" Classes="hint" BorderBrush="{StaticResource OnAirBrush}"
            IsVisible="{Binding AudioError, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding AudioError}" Foreground="{StaticResource OnAirBrush}" TextWrapping="Wrap" />
    </Border>

    <!-- ───────────── Decks + mixer ───────────── -->
    <Grid Grid.Row="2" ColumnDefinitions="*,212,*" ColumnSpacing="12">
      <v:DeckView x:Name="Deck1View" Label="1" Accent="{StaticResource Deck1Brush}"
                  DataContext="{Binding Deck1}" DragDrop.AllowDrop="True" />

      <Border Grid.Column="1" Classes="panel" Padding="14">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
          <!-- Auto-play and gap arrive with the queue step -->
          <Border CornerRadius="9" Padding="12,10" BorderThickness="1" BorderBrush="#3334D399" Background="#0F34D399"
                  Opacity="0.5" IsEnabled="False" ToolTip.Tip="Auto-play comes in the next step">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="AUTO-PLAY" Foreground="{StaticResource OkBrush}" />
              <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" Margin="0,-6" />
            </Grid>
          </Border>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Opacity="0.5">
            <TextBlock Classes="label" Text="GAP" />
            <TextBlock Grid.Column="1" Classes="mono" Text="3.0 s" FontWeight="SemiBold" />
          </Grid>

          <StackPanel Grid.Row="3" Spacing="6" DataContext="{Binding Mixer}" x:DataType="vm:MixerViewModel">
            <TextBlock Classes="label" HorizontalAlignment="Center" Text="{Binding LiveText}" />
            <Slider x:Name="Crossfader" Classes="crossfader" Minimum="0" Maximum="1" Value="{Binding Crossfader}"
                    SmallChange="0.05" LargeChange="0.25" ToolTip.Tip="Crossfader: fades the room between Deck 1 and Deck 2" />
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Classes="side" Content="1" Command="{Binding SnapTo1Command}"
                      Foreground="{StaticResource Deck1Brush}" ToolTip.Tip="Switch the room to Deck 1" />
              <Button Grid.Column="2" Classes="side" Content="2" Command="{Binding SnapTo2Command}"
                      Foreground="{StaticResource Deck2Brush}" ToolTip.Tip="Switch the room to Deck 2" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <v:DeckView x:Name="Deck2View" Grid.Column="2" Label="2" Accent="{StaticResource Deck2Brush}"
                  DataContext="{Binding Deck2}" DragDrop.AllowDrop="True" />
    </Grid>

    <!-- ───────────── Library ───────────── -->
    <Grid Grid.Row="3" ColumnDefinitions="260,12,*,12,320">

      <!-- Folder tree -->
      <Border Classes="panel">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panel-header">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="LIBRARY" />
              <Button Grid.Column="1" Classes="link" Content="+ Folder" Click="OnAddFolderClick"
                      ToolTip.Tip="Add a music folder to the library" />
            </Grid>
          </Border>
          <TreeView x:Name="FolderTree" Classes="folders" Margin="4,6"
                    ItemsSource="{Binding Library.Roots}"
                    SelectedItem="{Binding Library.SelectedFolder, Mode=TwoWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:FolderNodeViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7" Background="Transparent">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Rescan" Command="{Binding RescanCommand}" />
                      <MenuItem Header="Open folder" Command="{Binding OpenInFileManagerCommand}" />
                      <Separator IsVisible="{Binding IsRoot}" />
                      <MenuItem Header="Remove from library" Command="{Binding RemoveFromLibraryCommand}"
                                IsVisible="{Binding IsRoot}"
                                ToolTip.Tip="Forget this folder. Your files are not touched." />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <PathIcon Data="{StaticResource IconFolder}" Width="14" Height="14" Foreground="#8F9BB0" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Grid.Column="2" Classes="dim" Text="{Binding CountText}" FontSize="11"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

      <!-- Search + results -->
      <Border Grid.Column="2" Classes="panel">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Classes="panel-header" Height="56" Padding="12,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
              <Panel>
                <TextBox x:Name="SearchBox" Classes="search" Text="{Binding Library.SearchText}"
                         PlaceholderText="Search titles, artists, albums and folders" />
                <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource MutedBrush}" StrokeThickness="2.2"
                      StrokeLineCap="Round" Stretch="Uniform" Width="14" Height="14"
                      HorizontalAlignment="Left" Margin="12,0" IsHitTestVisible="False" />
                <Button Classes="link" HorizontalAlignment="Right" Margin="0,0,5,0" Padding="6"
                        Command="{Binding Library.ClearSearchCommand}" ToolTip.Tip="Clear search (Esc)"
                        IsVisible="{Binding Library.SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <Path Data="{StaticResource IconClose}" Stroke="{StaticResource MutedBrush}" StrokeThickness="2.4"
                        StrokeLineCap="Round" Stretch="Uniform" Width="9" Height="9" />
                </Button>
              </Panel>
              <Border Grid.Column="1" Classes="chip" IsVisible="{Binding Library.HasScope}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="{Binding Library.ScopeText}" FontSize="12" Foreground="#C8BCFF"
                             VerticalAlignment="Center" MaxWidth="340" TextTrimming="CharacterEllipsis" />
                  <Button Classes="link" Padding="5" Command="{Binding Library.ClearScopeCommand}"
                          ToolTip.Tip="Search the whole library">
                    <Path Data="{StaticResource IconClose}" Stroke="#C8BCFF" StrokeThickness="2.4"
                          StrokeLineCap="Round" Stretch="Uniform" Width="8" Height="8" />
                  </Button>
                </StackPanel>
              </Border>
              <TextBlock Grid.Column="2" Classes="muted" FontSize="12" VerticalAlignment="Center"
                         Text="{Binding Library.ResultSummary}" />
            </Grid>
          </Border>

          <DataGrid x:Name="TrackGrid" Grid.Row="1" Classes="tracks"
                    ItemsSource="{Binding Library.Results}"
                    IsReadOnly="True" SelectionMode="Extended"
                    CanUserSortColumns="True" CanUserResizeColumns="True" CanUserReorderColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="38" CanUserResize="False" CanUserSort="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate DataType="lib:Track">
                    <Button Classes="row-icon" Click="OnPreviewTrackClick" ToolTip.Tip="Preview in headphones"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Path Data="{StaticResource IconHeadphones}" Stroke="{Binding $parent[Button].Foreground}"
                            StrokeThickness="2.2" Stretch="Uniform" Width="14" Height="13" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Title" Width="2*" MinWidth="140" x:DataType="lib:Track"
                                  Binding="{Binding DisplayTitle}" />
              <DataGridTextColumn Header="Artist" Width="1.3*" MinWidth="100" x:DataType="lib:Track"
                                  Binding="{Binding Artist}" />
              <DataGridTextColumn Header="Album" Width="1.3*" MinWidth="100" x:DataType="lib:Track"
                                  Binding="{Binding Album}" />
              <DataGridTextColumn Header="Genre" Width="100" x:DataType="lib:Track"
                                  Binding="{Binding Genre}" />
              <DataGridTextColumn Header="Year" Width="76" CellStyleClasses="num" x:DataType="lib:Track"
                                  Binding="{Binding Year}" />
              <DataGridTextColumn Header="BPM" Width="72" CellStyleClasses="num" x:DataType="lib:Track"
                                  Binding="{Binding Bpm, Converter={x:Static app:Converters.Bpm}}" SortMemberPath="Bpm" />
              <DataGridTextColumn Header="Time" Width="76" CellStyleClasses="num" x:DataType="lib:Track"
                                  Binding="{Binding Duration, Converter={x:Static app:Converters.Duration}}" SortMemberPath="Duration" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
              <ContextMenu x:Name="TrackMenu">
                <MenuItem Header="Add to queue" InputGesture="Enter" Click="OnAddToQueueClick" />
                <MenuItem Header="Play next" InputGesture="Shift+Enter" Click="OnPlayNextClick" />
                <Separator />
                <MenuItem Header="Preview in headphones" InputGesture="Space" Click="OnPreviewSelectedClick" />
                <MenuItem x:Name="TrackLoad1" Header="Load to Deck 1" Tag="0" Click="OnLoadSelectedToDeckClick" />
                <MenuItem x:Name="TrackLoad2" Header="Load to Deck 2" Tag="1" Click="OnLoadSelectedToDeckClick" />
                <Separator />
                <MenuItem Header="Show in folder tree" Click="OnShowInTreeClick" />
                <MenuItem x:Name="RevealMenuItem" Header="Show in Explorer" Click="OnRevealFileClick" />
              </ContextMenu>
            </DataGrid.ContextMenu>
          </DataGrid>

          <!-- Empty states -->
          <StackPanel Grid.Row="1" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="{Binding Library.HasNoRoots}">
            <TextBlock Text="Add your music folder to get started" FontSize="17" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Classes="muted" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap"
                       Text="GZJam shows your folders exactly as they are on disk, and never moves or renames your files." />
            <Button Content="Add folder…" HorizontalAlignment="Center" Padding="16,8" Click="OnAddFolderClick"
                    Background="{StaticResource AccentBrush}" Foreground="White" />
          </StackPanel>
          <TextBlock Grid.Row="1" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Text="{Binding Library.EmptyMessage}" IsVisible="{Binding Library.HasNoResults}" />

          <!-- Headphone preview -->
          <Border Grid.Row="2" Classes="preview-bar" DataContext="{Binding Preview}" x:DataType="vm:PreviewViewModel"
                  IsVisible="{Binding IsActive, FallbackValue=False}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
              <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Deck2Brush}">
                <Path Data="{StaticResource IconHeadphones}" Stroke="#111" StrokeThickness="2.4"
                      Stretch="Uniform" Width="15" Height="14" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="260">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted" FontSize="11" Text="Previewing in headphones" />
              </StackPanel>
              <c:SeekBar x:Name="PreviewSeek" Grid.Column="2" Height="28" Progress="{Binding Progress}"
                         Fill="{StaticResource Deck2Brush}" CornerRadius="5" />
              <TextBlock Grid.Column="3" Classes="muted mono" FontSize="12" Text="{Binding TimeText}" VerticalAlignment="Center" />
              <Button Grid.Column="4" Classes="deck-button" Content="Stop" Command="{Binding StopCommand}" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Background="Transparent" ResizeDirection="Columns" />

      <!-- Queue -->
      <Border Grid.Column="4" Classes="panel">
        <Grid RowDefinitions="Auto,*">
          <Border Classes="panel-header">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="label" Text="QUEUE" />
              <TextBlock Grid.Column="1" Classes="muted" FontSize="11.5" VerticalAlignment="Center"
                         Text="{Binding Queue.Summary}" />
            </Grid>
          </Border>

          <Panel Grid.Row="1" x:Name="QueueArea" Background="Transparent" DragDrop.AllowDrop="True">
            <ListBox x:Name="QueueList" Classes="queue" ItemsSource="{Binding Queue.Items}" SelectionMode="Multiple">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:QueueItem">
                  <Grid ColumnDefinitions="Auto,20,*,Auto,Auto" ColumnSpacing="6" Margin="0,0,2,0" Background="Transparent">
                    <!-- Drag handle: on touch, reorder by dragging here so swiping elsewhere scrolls. -->
                    <Border Classes="grip" Background="Transparent" Width="26" Cursor="SizeAll"
                            ToolTip.Tip="Drag to reorder">
                      <TextBlock Classes="dim" Text="⋮⋮" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Classes="dim mono" Text="{Binding Number}" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,7">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" Text="{Binding Artist}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                      <TextBlock Classes="muted mono" Text="{Binding BpmText}" FontSize="11" />
                      <TextBlock Classes="muted mono" Text="{Binding DurationText}" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="4" Classes="row-icon" Click="OnPreviewQueueItemClick" ToolTip.Tip="Preview in headphones"
                            VerticalAlignment="Center">
                      <Path Data="{StaticResource IconHeadphones}" Stroke="{Binding $parent[Button].Foreground}"
                            StrokeThickness="2.2" Stretch="Uniform" Width="14" Height="13" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.ContextMenu>
                <ContextMenu x:Name="QueueMenu">
                  <MenuItem Header="Move to top" Click="OnQueueMoveToTopClick" />
                  <MenuItem Header="Remove" InputGesture="Delete" Click="OnQueueRemoveClick" />
                  <Separator />
                  <MenuItem Header="Preview in headphones" Click="OnPreviewQueueSelectedClick" />
                  <MenuItem x:Name="QueueLoad1" Header="Load to Deck 1" Tag="0" Click="OnLoadQueueToDeckClick" />
                  <MenuItem x:Name="QueueLoad2" Header="Load to Deck 2" Tag="1" Click="OnLoadQueueToDeckClick" />
                  <Separator />
                  <MenuItem Header="Clear queue" Click="OnQueueClearClick" />
                </ContextMenu>
              </ListBox.ContextMenu>
            </ListBox>

            <TextBlock Classes="muted" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" IsHitTestVisible="False" IsVisible="{Binding Queue.IsEmpty}"
                       Text="Drag tracks here&#10;or right-click › Add to queue" />

            <Border x:Name="QueueDropLine" Height="2" CornerRadius="1" Margin="8,0" VerticalAlignment="Top"
                    Background="{StaticResource AccentBrush}" IsVisible="False" IsHitTestVisible="False" />
          </Panel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
