<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GZJam.App.ViewModels"
        x:Class="GZJam.App.Views.AddToMyMusicDialog"
        x:DataType="vm:AddPlaceViewModel"
        Width="480" Height="560" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="GZJam">
  <!-- Add to my music: which folder of My music the songs go to (#324) -->
  <Window.Styles>
    <Style Selector="TreeViewItem" x:DataType="vm:AddFolderRow">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
  </Window.Styles>
  <Grid Margin="22" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" RowSpacing="10">
    <TextBlock x:Name="Heading" Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Grid.Row="1" Classes="muted" Text="{Binding Details}" TextWrapping="Wrap" />
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <TextBlock Text="Into:" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock x:Name="IntoText" Grid.Column="1" Text="{Binding IntoText}" TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding Folder}" VerticalAlignment="Center" />
      <Panel Grid.Column="2">
        <TextBlock Classes="muted" Text="{Binding IntoNote}" VerticalAlignment="Center" IsVisible="{Binding IsUsual}" />
        <Button x:Name="UsualButton" Classes="link" Content="Back to the usual place" IsVisible="{Binding CanGoBackToUsual}" />
      </Panel>
    </Grid>
    <Border Grid.Row="3" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="4">
      <TreeView x:Name="Folders" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
        <TreeView.ItemTemplate>
          <TreeDataTemplate DataType="vm:AddFolderRow" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Border>
    <StackPanel Grid.Row="4" Spacing="6">
      <Button x:Name="NewFolderButton" Classes="link" Content="+ New folder" IsEnabled="{Binding CanMakeFolder}"
              ToolTip.Tip="Make a folder inside the one selected" />
      <TextBlock Classes="muted" Text="{Binding Problem}" TextWrapping="Wrap" IsVisible="{Binding HasProblem}" />
    </StackPanel>
    <CheckBox x:Name="KeepFoldersBox" Grid.Row="5" Content="Keep their folders inside it" IsChecked="{Binding KeepFolders, Mode=TwoWay}"
              IsVisible="{Binding CanChooseKeepFolders}"
              ToolTip.Tip="Off: the songs go straight into this folder. On: in the folders they're in now, inside this one" />
    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="96" MinHeight="38"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
      <Button x:Name="AddButton" Content="{Binding Action}" IsDefault="True" MinWidth="96" MinHeight="38"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              Background="{StaticResource OnAirBrush}" Foreground="White" />
    </StackPanel>
  </Grid>
</Window>
