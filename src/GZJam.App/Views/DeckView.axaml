<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:GZJam.App.Views"
             xmlns:vm="using:GZJam.App.ViewModels"
             xmlns:c="using:GZJam.App.Controls"
             xmlns:lib="using:GZJam.Library"
             x:Class="GZJam.App.Views.DeckView"
             x:DataType="vm:DeckViewModel">
  <!-- Compact (four decks, half height): one line for the track and readout, a shorter waveform,
       and eject, marks and BPM behind the ⋯ button. -->
  <UserControl.Styles>
    <Style Selector="v|DeckView.compact :is(Control).full-only">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="v|DeckView:not(.compact) :is(Control).compact-only">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.deck-rows">
      <Setter Property="RowSpacing" Value="10" />
    </Style>
    <Style Selector="v|DeckView.compact Grid.deck-rows">
      <Setter Property="RowSpacing" Value="6" />
    </Style>
    <Style Selector="Border.deck">
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="v|DeckView.compact Border.deck">
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="c|SeekBar">
      <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style Selector="v|DeckView.compact c|SeekBar">
      <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="TextBlock.bpm">
      <Setter Property="FontSize" Value="24" />
    </Style>
    <Style Selector="v|DeckView.compact TextBlock.bpm">
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="c|PitchFader">
      <Setter Property="Height" Value="40" />
    </Style>
    <!-- Four decks: the waveform is short, so the JUMP key is too (with its margin, no taller than the
         waveform's 24 px: taller, it would grow the deck) -->
    <Style Selector="v|DeckView.compact Button.hw.jump">
      <Setter Property="MinHeight" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="9" />
    </Style>
    <Style Selector="v|DeckView.compact c|PitchFader">
      <Setter Property="Height" Value="26" />
    </Style>
    <!-- ON AIR / OFF AIR keeps its space when the deck isn't playing, and the same width either way
         (four decks: it's beside the title), so nothing moves as a deck starts or goes on air -->
    <Style Selector="StackPanel.status-line.idle">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="v|DeckView.compact TextBlock.status">
      <Setter Property="MinWidth" Value="54" />
    </Style>
    <!-- On air: a red bar along the top edge (the frame's padding is undone so it reaches the edges) -->
    <Style Selector="Border.onair-bar">
      <Setter Property="Height" Value="3" />
      <Setter Property="Background" Value="{StaticResource OnAirBrush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="-16,-14,-16,0" />
    </Style>
    <Style Selector="v|DeckView.compact Border.onair-bar">
      <Setter Property="Margin" Value="-12,-8,-12,0" />
    </Style>
    <!-- The deck's level meter, in the frame's padding along the edge nearest the mixer (Decks 2
         and 4: the left), so it takes no room from the deck's controls -->
    <Style Selector="c|LevelMeter.deck-meter">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Width" Value="6" />
      <Setter Property="Margin" Value="0,0,-11,0" />
    </Style>
    <Style Selector="v|DeckView.meter-left c|LevelMeter.deck-meter">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="-11,0,0,0" />
    </Style>
    <Style Selector="v|DeckView.compact c|LevelMeter.deck-meter">
      <Setter Property="Width" Value="5" />
      <Setter Property="Margin" Value="0,0,-8,0" />
    </Style>
    <Style Selector="v|DeckView.compact.meter-left c|LevelMeter.deck-meter">
      <Setter Property="Margin" Value="-8,0,0,0" />
    </Style>
    <Style Selector="StackPanel.tempo">
      <Setter Property="Width" Value="170" />
    </Style>
    <Style Selector="v|DeckView.compact StackPanel.tempo">
      <Setter Property="Width" Value="140" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="Frame" Classes="panel deck" Classes.onair="{Binding IsOnAir}">
    <Panel>
    <c:LevelMeter x:Name="DeckMeter" Classes="deck-meter" IsMono="True" ShowScale="False" Left="{Binding Level}" Right="{Binding Level}"
                  ToolTip.Tip="This deck's level, before the crossfader: it shows even when the room can't hear the deck. The top light: as loud as the speakers go." />
    <Grid Classes="deck-rows" RowDefinitions="Auto,*,Auto">

      <!-- Number, track, readout -->
      <Grid Classes="full-only" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Border Classes="badge" VerticalAlignment="Top"
                Background="{Binding Accent, RelativeSource={RelativeSource AncestorType=v:DeckView}}">
          <TextBlock Text="{Binding Label}" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <StackPanel x:Name="StatusLine" Classes="status-line" Classes.idle="{Binding !IsPlaying}" Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
            <Border Classes="led red" Classes.on="{Binding IsOnAir}" />
            <TextBlock Classes="status" Classes.air="{Binding IsOnAir}" Text="{Binding Status}" />
          </StackPanel>
          <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     Classes.dim="{Binding !HasTrack}" ToolTip.Tip="{Binding Title}" />
          <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="2">
            <!-- Rate the song while it plays: tap to cycle, like the library columns -->
            <Button x:Name="RatingButton" Classes="row-icon" Padding="3,2" Click="OnRatingClick" IsVisible="{Binding HasTrack}"
                    VerticalAlignment="Center" ToolTip.Tip="Would you play this for a dance? Tap: ♥ yes, then broken heart: no, then unrated.">
              <c:RatingIcon Rating="{Binding Track?.Rating, TargetNullValue={x:Static lib:Rating.Unrated}}" Width="14" Height="14" />
            </Button>
            <Button x:Name="EnergyButton" Grid.Column="1" Classes="row-icon" Padding="5,3" Click="OnEnergyClick" IsVisible="{Binding HasTrack}"
                    VerticalAlignment="Center" ToolTip.Tip="Energy. Tap: low, medium, high, then unset.">
              <c:EnergyIcon Energy="{Binding Track?.Energy, TargetNullValue={x:Static lib:Energy.Unset}}" Width="14" Height="11" />
            </Button>
            <!-- EQ for this song (lit when set) -->
            <Button x:Name="EqButton" Grid.Column="2" Classes="eq-chip" Classes.on="{Binding IsEqSet}" Margin="4,0,2,0"
                    IsVisible="{Binding HasTrack}" ToolTip.Tip="EQ for this song: low, mid, high (e.g. less hiss)">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Border Classes="led accent" Classes.on="{Binding IsEqSet}" />
                <TextBlock Text="EQ" />
              </StackPanel>
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="eq">
                  <v:EqPanel />
                </Flyout>
              </Button.Flyout>
            </Button>
            <TextBlock Grid.Column="3" Classes="muted" Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="4,0,0,0" />
          </Grid>
        </StackPanel>
        <Button Grid.Column="2" Classes="readout" Classes.empty="{Binding !HasTrack}" Command="{Binding CycleReadoutCommand}" VerticalAlignment="Top"
                ToolTip.Tip="Tap to switch between time left, time elapsed and BPM. Right-click if the BPM is wrong.">
          <Button.ContextMenu>
            <ContextMenu x:Name="ReadoutBpmMenu" />
          </Button.ContextMenu>
          <StackPanel>
            <TextBlock Classes="mono" Text="{Binding ReadoutText}" FontSize="38" FontWeight="SemiBold"
                       HorizontalAlignment="Right" LineHeight="40"
                       Foreground="{Binding Accent, RelativeSource={RelativeSource AncestorType=v:DeckView}}" />
            <TextBlock Classes="muted mono" Text="{Binding ReadoutCaption}" FontSize="12" HorizontalAlignment="Right" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- The same on one line, for four decks -->
      <Grid Classes="compact-only" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
        <Border Classes="badge small" VerticalAlignment="Center"
                Background="{Binding Accent, RelativeSource={RelativeSource AncestorType=v:DeckView}}">
          <TextBlock Text="{Binding Label}" />
        </Border>
        <StackPanel x:Name="CompactStatusLine" Grid.Column="1" Classes="status-line" Classes.idle="{Binding !IsPlaying}" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Border Classes="led red" Classes.on="{Binding IsOnAir}" />
          <TextBlock Classes="status" Classes.air="{Binding IsOnAir}" Text="{Binding Status}" />
        </StackPanel>
        <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"
                   Classes.dim="{Binding !HasTrack}">
          <Run Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
          <Run Text="  " />
          <Run Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
        </TextBlock>
        <Button x:Name="CompactEqButton" Grid.Column="3" Classes="eq-chip" Classes.on="{Binding IsEqSet}"
                IsVisible="{Binding HasTrack}" ToolTip.Tip="EQ for this song: low, mid, high (e.g. less hiss)">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Border Classes="led accent" Classes.on="{Binding IsEqSet}" />
            <TextBlock Text="EQ" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="eq">
              <v:EqPanel />
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Grid.Column="4" Classes="readout" Classes.empty="{Binding !HasTrack}" Command="{Binding CycleReadoutCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Tap to switch between time left, time elapsed and BPM.">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Classes="mono" Text="{Binding ReadoutText}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{Binding Accent, RelativeSource={RelativeSource AncestorType=v:DeckView}}" />
            <TextBlock Classes="muted mono" Text="{Binding ReadoutCaption}" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Waveform and position. Seeking is blocked while the room is hearing the deck. -->
      <Panel Grid.Row="1">
        <c:SeekBar x:Name="Seek" Progress="{Binding Progress}" IsEnabled="{Binding HasTrack}" IsLocked="{Binding !CanSeek}"
                   Waveform="{Binding Waveform}" TrimStart="{Binding TrimStart}" TrimEnd="{Binding TrimEnd}"
                   IsStartManual="{Binding IsStartManual}" IsEndManual="{Binding IsEndManual}"
                   Jumps="{Binding JumpMarkers}" PendingJumpFrom="{Binding PendingJumpFrom}" Cues="{Binding CueMarkers}"
                   Fill="{Binding Accent, RelativeSource={RelativeSource AncestorType=v:DeckView}}">
          <!-- Right-click or long-press: set where the song starts and ends -->
          <c:SeekBar.ContextMenu>
            <ContextMenu x:Name="TrimMenu" />
          </c:SeekBar.ContextMenu>
        </c:SeekBar>
        <TextBlock Classes="dim" Text="Analyzing…" FontSize="11" Margin="10,6" HorizontalAlignment="Left" VerticalAlignment="Top"
                   IsVisible="{Binding IsAnalyzing}" IsHitTestVisible="False" />
        <!-- The song's jumps: lit = the next one will happen. Tap to cancel, or to arm again. -->
        <Button x:Name="JumpButton" Classes="hw jump" Command="{Binding ToggleJumpCommand}" IsVisible="{Binding HasJumps}"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                ToolTip.Tip="Jumps: lit means the song will jump. Tap to cancel for this play, or to arm again.">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Classes="led green" Classes.on="{Binding IsJumpArmed}" />
            <TextBlock Text="JUMP" />
          </StackPanel>
        </Button>
        <!-- The song's cues: tap one to carry on from there, now (on air too). Four decks: in the ⋯ menu. -->
        <ItemsControl x:Name="CueKeys" Classes="full-only" ItemsSource="{Binding Cues}"
                      HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Classes="cue-keys" Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="lib:SongCue">
              <Button Classes="hw cue-key" Content="{Binding Number}" CommandParameter="{Binding Number}"
                      Command="{Binding $parent[v:DeckView].((vm:DeckViewModel)DataContext).GoToCueCommand}"
                      ToolTip.Tip="Go to this cue now (the number on the waveform)" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="hint" IsVisible="{Binding Hint, Converter={x:Static ObjectConverters.IsNotNull}}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{Binding Hint}" />
        </Border>
      </Panel>

      <!-- Transport and tempo -->
      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
        <!-- columns: play, cue, fade, eject (stretches), tempo, BPM, more (compact) -->
        <Button x:Name="PlayButton" Classes="play" Classes.playing="{Binding IsPlaying}" Classes.armed="{Binding IsPauseArmed}"
                IsEnabled="{Binding HasTrack}"
                BorderBrush="{Binding Accent, RelativeSource={RelativeSource AncestorType=v:DeckView}}"
                Foreground="{Binding Accent, RelativeSource={RelativeSource AncestorType=v:DeckView}}"
                ToolTip.Tip="Play / pause">
          <Panel>
            <PathIcon Data="{StaticResource IconPlay}" Width="{DynamicResource DeckPlayIconSize}" Height="{DynamicResource DeckPlayIconSize}"
                      IsVisible="{Binding !IsPlaying}" />
            <PathIcon Data="{StaticResource IconPause}" Width="{DynamicResource DeckPauseIconSize}" Height="{DynamicResource DeckPauseIconSize}"
                      IsVisible="{Binding IsPlaying}" />
          </Panel>
        </Button>
        <!-- Cue: this deck in the headphones, whatever the crossfader is doing -->
        <ToggleButton x:Name="CueButton" Grid.Column="1" Classes="hw cue-button" IsChecked="{Binding IsCueOn}"
                      ToolTip.Tip="Cue: send this deck to your headphones">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="led amber" Classes.on="{Binding IsCueOn}" />
            <TextBlock Text="CUE" />
          </StackPanel>
        </ToggleButton>
        <Button Grid.Column="2" Classes="hw" Command="{Binding FadeOutCommand}" IsEnabled="{Binding IsPlaying}"
                ToolTip.Tip="Fade out and stop (length in Settings)">
          <TextBlock Text="FADE OUT" />
        </Button>
        <Panel Grid.Column="3" Classes="full-only">
          <Button Classes="link" Content="Eject" Command="{Binding EjectCommand}" HorizontalAlignment="Left"
                  IsVisible="{Binding HasTrack}" IsEnabled="{Binding !IsPlaying}" VerticalAlignment="Center" />
        </Panel>

        <Grid Grid.Column="4" ColumnDefinitions="Auto,*" ColumnSpacing="4" VerticalAlignment="Center">
          <Button Classes="link compact-only" Padding="2,0" Command="{Binding ResetTempoCommand}" VerticalAlignment="Center"
                  ToolTip.Tip="Tempo (pitch stays the same). Tap to reset.">
            <TextBlock Classes="mono" Text="{Binding TempoText}" FontSize="11" MinWidth="38" TextAlignment="Right" />
          </Button>
          <StackPanel Grid.Column="1" Classes="tempo" VerticalAlignment="Center" Spacing="0">
            <Button Classes="link full-only" Padding="6,0" HorizontalAlignment="Center" Command="{Binding ResetTempoCommand}"
                    ToolTip.Tip="Tempo (pitch stays the same). Tap to reset.">
              <TextBlock Classes="mono" Text="{Binding TempoText}" FontSize="11" />
            </Button>
            <c:PitchFader x:Name="TempoFader" Value="{Binding TempoPercent}" IsEnabled="{Binding HasTrack}"
                          ToolTip.Tip="Tempo, ±8% (pitch stays the same). Drag; double-tap for 0." />
          </StackPanel>
        </Grid>

        <!-- Right-click (or long-press) the BPM to detect it again in a range -->
        <StackPanel x:Name="BpmPanel" Grid.Column="5" VerticalAlignment="Center" MinWidth="56" Background="Transparent"
                    ToolTip.Tip="Right-click if the BPM is wrong">
          <StackPanel.ContextMenu>
            <ContextMenu x:Name="BpmContextMenu" />
          </StackPanel.ContextMenu>
          <TextBlock Classes="mono bpm" Text="{Binding BpmText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
          <TextBlock Classes="muted full-only" Text="{Binding BpmCaption}" FontSize="10.5" HorizontalAlignment="Right" />
        </StackPanel>

        <!-- Four decks: eject, rating, energy and BPM, which have no room on the deck itself -->
        <Button x:Name="MoreButton" Grid.Column="6" Classes="link compact-only" Padding="6,2" VerticalAlignment="Center"
                ToolTip.Tip="More: eject, rating, energy, BPM">
          <TextBlock Text="⋯" FontSize="18" FontWeight="Bold" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight" />
          </Button.Flyout>
        </Button>
      </Grid>
    </Grid>
    <Border Classes="onair-bar" IsVisible="{Binding IsOnAir}" IsHitTestVisible="False" />
    </Panel>
  </Border>
</UserControl>
