<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GZJam.App.ViewModels"
        xmlns:c="using:GZJam.App.Controls"
        x:Class="GZJam.App.Views.SongInfoWindow"
        x:DataType="vm:SongInfoViewModel"
        Width="880" Height="680" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        c:AlbumArt.Cache="{Binding Art}"
        Title="{Binding Heading, StringFormat='{}{0} · Song info'}">
  <!--
    A song's info, or several songs' (#129). The header says what it is and what a DJ looks for
    first. Below, the tags on the left, edited in place; the file and what GZJam knows on the right,
    its rating, energy and labels edited too. Saved together, with Undo.
  -->
  <Window.Resources>
    <DataTemplate x:Key="InfoRowTemplate" x:DataType="vm:InfoRow">
      <Grid ColumnDefinitions="104,*" ColumnSpacing="12" Margin="0,2">
        <TextBlock Classes="muted" Text="{Binding Name}" TextWrapping="Wrap" />
        <SelectableTextBlock Grid.Column="1" Text="{Binding Shown}" TextWrapping="Wrap" Opacity="{Binding Opacity}" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="TagFieldTemplate" x:DataType="vm:TagField">
      <Grid ColumnDefinitions="104,*" ColumnSpacing="12" Margin="0,1">
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
          <TextBlock Classes="muted" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
          <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"
                   IsVisible="{Binding IsLibraryEdit}" ToolTip.Tip="{Binding LibraryEditTip}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBox Classes="tag-field" Text="{Binding Text}" PlaceholderText="{Binding Watermark}" IsReadOnly="{Binding IsReadOnly}"
                   ToolTip.Tip="{Binding Text}">
            <TextBox.InnerRightContent>
              <Button Classes="link clear-all" Content="✕" Padding="6,0" IsVisible="{Binding CanClearAll}" Command="{Binding ClearAllCommand}"
                      ToolTip.Tip="Take this tag off every one of the songs" />
            </TextBox.InnerRightContent>
          </TextBox>
          <TextBlock Classes="setting-help" Foreground="{StaticResource OnAirBrush}" Text="{Binding Error}"
                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBox.tag-field">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="7,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- "Clear on every song", only where the pointer or the keyboard is: not a column of crosses -->
    <Style Selector="TextBox.tag-field Button.clear-all">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="TextBox.tag-field:pointerover Button.clear-all, TextBox.tag-field:focus-within Button.clear-all">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBox.tag-field:readonly /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1" Padding="20,16">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <c:AlbumArt x:Name="HeaderArt" Width="76" Height="76" CornerRadius="4" VerticalAlignment="Top"
                    SongPath="{Binding Track.Path}" />
        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
          <SelectableTextBlock x:Name="HeadingText" Text="{Binding Heading}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
          <SelectableTextBlock Classes="muted" Text="{Binding Artist}" FontSize="14" TextWrapping="Wrap"
                               IsVisible="{Binding Artist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock x:Name="SummaryText" Classes="mono" FontSize="12" Margin="0,6,0,0" Text="{Binding Summary}" TextWrapping="Wrap"
                     IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock x:Name="ProblemText" Text="{Binding Problem}" Foreground="{StaticResource OnAirBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                     IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock x:Name="SavedText" Classes="setting-help" Text="{Binding SavedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button x:Name="RevealButton" Classes="hw" Click="OnRevealClick" IsVisible="{Binding IsSingle}" />
          <Button x:Name="UndoButton" Classes="hw" Content="UNDO" MinWidth="88" IsVisible="{Binding CanUndo}" Click="OnUndoClick"
                  ToolTip.Tip="Put back what the last save changed" />
          <Button x:Name="CancelButton" Classes="hw" Content="CANCEL" MinWidth="88" IsVisible="{Binding HasChanges}" Click="OnCancelClick"
                  ToolTip.Tip="Put every field back as it was" />
          <Button x:Name="SaveButton" Classes="hw" Content="SAVE" MinWidth="88" IsEnabled="{Binding CanSave}" IsVisible="{Binding IsEditable}"
                  Click="OnSaveClick" />
          <Button x:Name="CloseButton" Classes="hw" Content="CLOSE" IsCancel="True" MinWidth="88" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="32" Margin="20,16,20,20">
        <!-- The tags: the files', as GZJam shows them, edited in place -->
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="TAGS" VerticalAlignment="Center" />
            <Button x:Name="UseFileTagsButton" Grid.Column="1" Classes="link" Content="Use the files' tags" Padding="6,0"
                    IsVisible="{Binding HasLibraryEdits}" Click="OnUseFileTagsClick"
                    ToolTip.Tip="The tags marked with a dot are GZJam's own edits, kept in its library. This forgets them: the songs show what their files say again." />
          </Grid>
          <ItemsControl x:Name="TagsList" ItemsSource="{Binding Tags}" ItemTemplate="{StaticResource TagFieldTemplate}" />

          <StackPanel Spacing="6" IsVisible="{Binding HasOtherTags}">
            <TextBlock Classes="label" Text="OTHER TAGS IN THE FILE" Margin="0,10,0,0" />
            <ItemsControl x:Name="OtherTagsList" ItemsSource="{Binding OtherTags}" ItemTemplate="{StaticResource TagFieldTemplate}" />
          </StackPanel>

          <StackPanel Spacing="2" IsVisible="{Binding IsEditable}" Margin="0,4,0,0">
            <Grid ColumnDefinitions="104,*,Auto" ColumnSpacing="12">
              <TextBox x:Name="NewTagNameBox" Classes="tag-field" PlaceholderText="Add a tag" Text="{Binding NewTagName}" KeyDown="OnNewTagKeyDown"
                       ToolTip.Tip="Its name: Dance, Composer, Mood..." />
              <TextBox x:Name="NewTagValueBox" Grid.Column="1" Classes="tag-field" PlaceholderText="Its value" Text="{Binding NewTagValue}"
                       KeyDown="OnNewTagKeyDown" />
              <Button x:Name="AddTagButton" Grid.Column="2" Classes="hw" Content="ADD" Click="OnAddTagClick"
                      IsEnabled="{Binding NewTagName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Grid>
            <TextBlock Classes="setting-help" Foreground="{StaticResource OnAirBrush}" Text="{Binding NewTagError}" TextWrapping="Wrap"
                       IsVisible="{Binding NewTagError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <TextBlock x:Name="ReadOnlyText" Classes="setting-help" Text="{Binding ReadOnlyReason}" TextWrapping="Wrap" Margin="0,6,0,0"
                     IsVisible="{Binding ReadOnlyReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <StackPanel Spacing="2" IsVisible="{Binding IsEditable}" Margin="0,8,0,0">
            <CheckBox x:Name="WriteTagsBox" IsChecked="{Binding Settings.WriteTagsToFiles}">
              <TextBlock Text="Write changes into the song files too" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Classes="setting-help" TextWrapping="Wrap" IsVisible="{Binding !Settings.WriteTagsToFiles}"
                       Text="Off: kept in GZJam's library only. GZJam shows and searches them; the files aren't changed." />
            <TextBlock Classes="setting-help" TextWrapping="Wrap" IsVisible="{Binding Settings.WriteTagsToFiles}"
                       Text="On: written into the files, so other players see them. Only the tags, never the audio; a song on a deck is kept in the library instead." />
          </StackPanel>

          <StackPanel Spacing="6" IsVisible="{Binding IsSingle}">
            <CheckBox x:Name="ShowAllTagsBox" IsChecked="{Binding ShowAllTags}" Margin="0,8,0,0"
                      ToolTip.Tip="The tags GZJam leaves out of its library: the ones only other programs use (MusicBrainz IDs, ReplayGain, the encoder, sort names), lyrics and other long ones">
              <TextBlock Text="Show all tags, the ones for other programs too" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Classes="setting-help" Text="{Binding LeftOutNote}" TextWrapping="Wrap"
                       IsVisible="{Binding LeftOutNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <StackPanel Spacing="6" IsVisible="{Binding IsLeftOutShown}">
              <TextBlock Classes="label" Text="FOR OTHER PROGRAMS" Margin="0,4,0,0" />
              <ItemsControl x:Name="LeftOutList" ItemsSource="{Binding LeftOutTags}" ItemTemplate="{StaticResource InfoRowTemplate}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- The file, and what GZJam knows: never in the file -->
        <StackPanel Grid.Column="1" Spacing="6">
          <TextBlock Classes="label" Text="{Binding FileHeading}" />
          <StackPanel>
            <Grid ColumnDefinitions="104,*" ColumnSpacing="12" Margin="0,2" IsVisible="{Binding IsSingle}">
              <TextBlock Classes="muted" Text="Location" />
              <SelectableTextBlock x:Name="LocationText" Grid.Column="1" Text="{Binding Location}" TextTrimming="LeadingCharacterEllipsis"
                                   ToolTip.Tip="{Binding Location}" />
            </Grid>
            <ItemsControl x:Name="FileList" ItemsSource="{Binding File}" ItemTemplate="{StaticResource InfoRowTemplate}" />
          </StackPanel>

          <TextBlock Classes="label" Text="IN GZJAM" Margin="0,10,0,0" />
          <Grid ColumnDefinitions="104,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
            <TextBlock Classes="muted" Text="Rating" VerticalAlignment="Center" />
            <ComboBox x:Name="RatingBox" Grid.Column="1" MinWidth="180" ItemsSource="{Binding RatingChoices}"
                      SelectedIndex="{Binding RatingIndex}" IsEnabled="{Binding IsEditable}" />
            <TextBlock Grid.Row="1" Classes="muted" Text="Energy" VerticalAlignment="Center" />
            <ComboBox x:Name="EnergyBox" Grid.Row="1" Grid.Column="1" MinWidth="180" ItemsSource="{Binding EnergyChoices}"
                      SelectedIndex="{Binding EnergyIndex}" IsEnabled="{Binding IsEditable}" />
            <TextBlock Grid.Row="2" Classes="muted" Text="Labels" Margin="0,4,0,0" />
            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
              <ItemsControl x:Name="LabelsList" ItemsSource="{Binding Labels}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LabelChoice">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsThreeState="{Binding IsThreeState}" Margin="0,0,12,0"
                              IsEnabled="{Binding $parent[Window].((vm:SongInfoViewModel)DataContext).IsEditable}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsEditable}">
                <TextBox x:Name="NewLabelBox" Classes="tag-field" PlaceholderText="Add a label" Text="{Binding NewLabel}" KeyDown="OnNewLabelKeyDown" />
                <Button x:Name="AddLabelButton" Grid.Column="1" Classes="hw" Content="ADD" Click="OnAddLabelClick"
                        IsEnabled="{Binding NewLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </Grid>
            </StackPanel>
          </Grid>
          <ItemsControl x:Name="GZJamList" ItemsSource="{Binding InGZJam}" ItemTemplate="{StaticResource InfoRowTemplate}" Margin="0,4,0,0" />
          <TextBlock Classes="setting-help" TextWrapping="Wrap" Text="Kept in GZJam's library, never in the files." />
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
