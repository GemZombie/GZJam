<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GZJam.App.Views.ServerChoicesDialog"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        Title="GZJam">
  <!-- What to keep on the computer from a server (#283): what's starred there, and its playlists -->
  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="Heading" Classes="label" Text="KEEP ON THIS LAPTOP" />
    <TextBlock Classes="setting-help" FontSize="12"
               Text="SYNC downloads what's ticked and not here yet. Each playlist becomes a GZJam playlist, kept up to date with the server's." />
    <TextBlock x:Name="Message" Classes="setting-help" FontSize="12" Text="Asking the server…" />
    <Border Classes="settings-card" Margin="0" MaxHeight="360">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ChoiceList" Margin="12,8" Spacing="2" />
      </ScrollViewer>
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button x:Name="CancelButton" Classes="hw" Content="CANCEL" IsCancel="True" MinWidth="88" />
      <Button x:Name="SaveButton" Classes="hw" Content="SAVE" MinWidth="88" IsEnabled="False" />
      <Button x:Name="SyncButton" Classes="hw" Content="SAVE AND SYNC" IsDefault="True" MinWidth="88" IsEnabled="False" />
    </StackPanel>
  </StackPanel>
</Window>
