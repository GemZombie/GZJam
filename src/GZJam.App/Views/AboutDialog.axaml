<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GZJam.App.Views.AboutDialog"
        Width="620" Height="600" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        Title="About GZJam">
  <!-- Settings › About: the version, who made GZJam, and what it's built with -->
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="32" Height="32" CornerRadius="4" Background="{StaticResource TextBrush}">
          <TextBlock Text="GZ" FontSize="14" FontWeight="Black" Foreground="{StaticResource BgBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="GZJam" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock x:Name="VersionText" Classes="muted mono" FontSize="13" VerticalAlignment="Center" Margin="2,4,0,0" />
      </StackPanel>
      <TextBlock x:Name="MakerText" TextWrapping="Wrap" Margin="0,4,0,0" />
      <Button x:Name="ProjectLink" Classes="link" Click="OnProjectClick" Margin="-6,-2,0,0" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="NoticesButton" Classes="hw" Content="FULL LICENCE TEXTS" Click="OnNoticesClick" />
      <Button x:Name="CloseButton" Classes="hw" Content="CLOSE" IsCancel="True" IsDefault="True" MinWidth="88" Click="OnCloseClick" />
    </StackPanel>

    <DockPanel Margin="0,16,0,0">
      <TextBlock DockPanel.Dock="Top" Classes="label" Text="BUILT WITH" Margin="0,0,0,8" />
      <Border Classes="readout-window" Padding="12,10">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <SelectableTextBlock x:Name="BuiltWithText" Classes="mono" FontSize="11.5" TextWrapping="Wrap" />
        </ScrollViewer>
      </Border>
    </DockPanel>
  </DockPanel>
</Window>
