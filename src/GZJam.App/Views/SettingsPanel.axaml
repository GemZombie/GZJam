<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:GZJam.App"
             xmlns:vm="using:GZJam.App.ViewModels"
             xmlns:c="using:GZJam.App.Controls"
             x:Class="GZJam.App.Views.SettingsPanel"
             x:DataType="vm:SettingsViewModel">
  <!-- Settings, over the dimmed main screen: sections down the side, one shown at a time -->
  <Border Classes="settings">
    <DockPanel>
      <Border DockPanel.Dock="Top" Classes="settings-head">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="settings-title" Text="SETTINGS" />
          <Button x:Name="DoneButton" Grid.Column="1" Classes="hw" Content="DONE" MinWidth="76" Click="OnDoneClick" />
        </Grid>
      </Border>

      <Border DockPanel.Dock="Left" Width="170" Background="{StaticResource SettingsNavBrush}"
              BorderBrush="{StaticResource SettingsLineBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="0,10">
          <TextBlock x:Name="NavVersionText" DockPanel.Dock="Bottom" Classes="dim" FontSize="11" Margin="18,0" />
          <!-- Some Linux desktops (Hyprland) draw no title bar, so no close button: this works on all (#55).
               Still asks first while the room hears a deck. -->
          <Button x:Name="QuitButton" DockPanel.Dock="Bottom" Classes="hw small" Content="QUIT GZJAM" Margin="14,0,14,10"
                  HorizontalAlignment="Left" Click="OnQuitClick" ToolTip.Tip="Close GZJam (asks first while the room hears music)" />
          <StackPanel>
            <RadioButton x:Name="NavSound" Classes="settings-nav" GroupName="SettingsSections" Content="Sound" IsChecked="True" />
            <RadioButton x:Name="NavDecks" Classes="settings-nav" GroupName="SettingsSections" Content="Decks" />
            <RadioButton x:Name="NavScreen" Classes="settings-nav" GroupName="SettingsSections" Content="Screen" />
            <RadioButton x:Name="NavLibrary" Classes="settings-nav" GroupName="SettingsSections" Content="Library" />
            <RadioButton x:Name="NavServers" Classes="settings-nav" GroupName="SettingsSections" Content="Servers" />
            <RadioButton x:Name="NavAbout" Classes="settings-nav" GroupName="SettingsSections" Content="About" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Panel>
        <!-- ───────────── Sound ───────────── -->
        <ScrollViewer x:Name="SoundPage" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="20,16">
            <TextBlock Classes="settings-group" Text="OUTPUTS" />
            <Border Classes="settings-card">
              <StackPanel>
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="led on red" VerticalAlignment="Center" />
                      <TextBlock Classes="setting" Text="Speakers" />
                    </StackPanel>
                    <TextBlock Classes="setting-help" Text="What the room hears." IsVisible="{Binding !SplitOutput}" />
                    <TextBlock x:Name="SpeakersSplitHelp" Classes="setting-help" IsVisible="{Binding SplitOutput}"
                               Text="What the room hears: the left side of this output." />
                  </StackPanel>
                  <ComboBox x:Name="MainDeviceBox" Grid.Column="1" ItemsSource="{Binding MainDevices}" SelectedItem="{Binding MainDevice}" />
                </Grid>
                <StackPanel IsVisible="{Binding ShowsExclusiveSpeakers}">
                  <Border Classes="settings-rule" />
                  <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="setting" Text="Speakers for GZJam alone" />
                      <TextBlock Classes="setting-help"
                                 Text="While GZJam is open, other programs' sounds (a notification, a browser) can't reach the room, and other music programs can't use these speakers. For a laptop kept for gigs. For an output chosen by name, not Default." />
                      <TextBlock x:Name="WindowsDefaultHint" Classes="setting-help" FontWeight="SemiBold" Margin="0,4,0,0"
                                 IsVisible="{Binding SpeakersAreWindowsDefault}"
                                 Text="These speakers are also Windows' default output, so other programs may refuse to play while GZJam is open. To keep them playing, choose another output in Windows' Sound settings." />
                    </StackPanel>
                    <ToggleButton x:Name="ExclusiveSpeakersSwitch" Grid.Column="1" Classes="switch" VerticalAlignment="Center" IsChecked="{Binding ExclusiveSpeakers}" />
                  </Grid>
                </StackPanel>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="One output for both (splitter cable)" />
                    <TextBlock Classes="setting-help"
                               Text="For a laptop with one output. Plug a splitter cable into it: the room plays from the left plug, your headphones from the right. Hearing it the wrong way round? Swap the two plugs." />
                  </StackPanel>
                  <ToggleButton x:Name="SplitOutputSwitch" Grid.Column="1" Classes="switch" VerticalAlignment="Center"
                                IsChecked="{Binding SplitOutput}" IsEnabled="{Binding CanSplitOutput}" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="led on amber" VerticalAlignment="Center" />
                      <TextBlock Classes="setting" Text="Headphones" />
                    </StackPanel>
                    <TextBlock Classes="setting-help" Text="Only you hear this. It never goes to the room. Unplugged, they go quiet, and come back when plugged in." />
                    <TextBlock x:Name="HeadphonesDefaultHint" Classes="setting-help" FontWeight="SemiBold" Margin="0,4,0,0"
                               IsVisible="{Binding HeadphonesFollowDefault}" TextWrapping="Wrap"
                               Text="Default follows the computer's own choice: unplug the headphones and it may move the preview to another output, even the room's. Choose them by name." />
                  </StackPanel>
                  <ComboBox x:Name="CueDeviceBox" Grid.Column="1" ItemsSource="{Binding CueDevices}" SelectedItem="{Binding CueDevice}"
                            IsVisible="{Binding !SplitOutput}" />
                  <TextBlock x:Name="CueSplitText" Grid.Column="1" Classes="setting-help" VerticalAlignment="Center" MaxWidth="260"
                             TextAlignment="Right" IsVisible="{Binding SplitOutput}" Text="The right side of the speakers' output" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="led on accent" VerticalAlignment="Center" />
                      <TextBlock Classes="setting" Text="Booth" />
                    </StackPanel>
                    <TextBlock Classes="setting-help" Text="A speaker for you at the DJ table: what the room hears, at its own volume." />
                  </StackPanel>
                  <ComboBox x:Name="BoothDeviceBox" Grid.Column="1" ItemsSource="{Binding BoothDevices}" SelectedItem="{Binding BoothDevice}" />
                </Grid>
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto" IsVisible="{Binding HasBooth}">
                  <TextBlock Classes="setting" Text="Booth volume" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Button x:Name="BoothQuieterButton" Classes="hw step" Content="−" Command="{Binding BoothQuieterCommand}" />
                    <TextBlock x:Name="BoothVolumeText" Classes="mono" Text="{Binding BoothVolumeText}" MinWidth="58" TextAlignment="Center" VerticalAlignment="Center" />
                    <Button x:Name="BoothLouderButton" Classes="hw step" Content="+" Command="{Binding BoothLouderCommand}" />
                  </StackPanel>
                </Grid>
                <Button Classes="link" Content="Plugged something in? Refresh the list" Command="{Binding RefreshDevicesCommand}"
                        HorizontalAlignment="Left" Margin="8,-6,0,6" />
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="setting" Text="Protection against crackles" />
                    <TextBlock Classes="setting-help"
                               Text="If the sound crackles or drops out on this computer, choose a higher one. The higher it is, the later play and the crossfader are heard: Low 0.2 s, Normal 0.35 s, High 0.6 s, Highest 1 s." />
                  </StackPanel>
                  <ComboBox x:Name="SoundBufferBox" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding BufferChoices}" SelectedItem="{Binding BufferChoice}" />
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Classes="settings-group" Text="PLAYBACK" />
            <!-- A venue loaded (#440): these two are its own -->
            <TextBlock x:Name="VenueNote" Classes="setting-help" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,6"
                       Text="{Binding VenueNote}" IsVisible="{Binding VenueNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <Border Classes="settings-card">
              <StackPanel>
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Mono" />
                    <TextBlock Classes="setting-help"
                               Text="Both sides play the same, in the speakers, booth and headphones: the whole floor hears instruments recorded on one side, and you hear what the room hears, with either ear. A venue can have its own, in its room EQ panel." />
                  </StackPanel>
                  <ToggleButton x:Name="MonoSwitch" Grid.Column="1" Classes="switch" VerticalAlignment="Center" IsChecked="{Binding Mono}" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Match loudness" />
                    <TextBlock Classes="setting-help"
                               Text="Quiet old transfers and loud remasters play at about the same level. Adjust a song in its EQ panel (GAIN)." />
                  </StackPanel>
                  <ToggleButton x:Name="MatchLoudnessSwitch" Grid.Column="1" Classes="switch" VerticalAlignment="Center" IsChecked="{Binding MatchLoudness}" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto" IsEnabled="{Binding MatchLoudness}">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="setting" Text="Matched level" />
                    <TextBlock Classes="setting-help"
                               Text="How loud songs come out once matched. Lower leaves more headroom, for a mixer or PA that clips easily: turn the mixer's channel up to make up for it. A venue can have its own, in its room EQ panel." />
                  </StackPanel>
                  <ComboBox x:Name="LoudnessTargetBox" Grid.Column="1" ItemsSource="{Binding LoudnessTargetChoices}" SelectedItem="{Binding LoudnessTargetChoice}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ───────────── Decks ───────────── -->
        <ScrollViewer x:Name="DecksPage" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
          <StackPanel Margin="20,16">
            <TextBlock Classes="settings-group" Text="DECKS" />
            <Border Classes="settings-card">
              <StackPanel>
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Four decks" />
                    <TextBlock Classes="setting-help" Text="Decks 3 and 4 sit under 1 and 2, each half height. The crossfader fades 1 and 3 against 2 and 4." />
                  </StackPanel>
                  <ToggleButton x:Name="FourDecksSwitch" Grid.Column="1" Classes="switch" VerticalAlignment="Center" IsChecked="{Binding FourDecks}" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Deck size" />
                    <TextBlock Classes="setting-help" Text="Compact decks leave the library and queue more songs; hidden ones leave the most, with one line at the top for what's playing and what's next. Also from the switch in the top bar, Ctrl+D and Ctrl+Shift+D (Cmd on a Mac), or the grip under the decks." />
                  </StackPanel>
                  <ComboBox x:Name="DeckSizeBox" Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding DeckSizeChoices}" SelectedItem="{Binding DeckSizeChoice}" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Fade-out length" />
                    <TextBlock Classes="setting-help" Text="How long a deck's FADE OUT key takes to bring it down to silence." />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Button Classes="hw step" Content="−" Command="{Binding FadeOutShorterCommand}" />
                    <Border Classes="readout-window" MinWidth="52">
                      <TextBlock Classes="mono" Text="{Binding FadeOutText}" FontWeight="SemiBold" FontSize="12.5"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button Classes="hw step" Content="+" Command="{Binding FadeOutLongerCommand}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Classes="settings-group" Text="SAFETY" />
            <Border Classes="settings-card">
              <StackPanel>
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="setting" Text="Loading a playing deck" />
                    <TextBlock Classes="setting-help" Text="When a song is dropped on the deck the room hears (ON AIR). One playing OFF AIR always takes it." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding LoadChoices}" SelectedItem="{Binding LoadChoice}" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="setting" Text="Pausing or fading out the live deck" />
                    <TextBlock Classes="setting-help" Text="The deck the room is hearing. Tap twice: PAUSE and FADE OUT each need a second tap." />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding PauseChoices}" SelectedItem="{Binding PauseChoice}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ───────────── Screen ───────────── -->
        <ScrollViewer x:Name="ScreenPage" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
          <StackPanel Margin="20,16">
            <TextBlock Classes="settings-group" Text="SCREEN" />
            <Border Classes="settings-card">
              <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="setting" Text="Touch mode" />
                  <TextBlock Classes="setting-help" Text="Bigger keys, rows, menus and crossfader for fingers. Dragging works by touch either way." />
                </StackPanel>
                <ToggleButton x:Name="TouchModeSwitch" Grid.Column="1" Classes="switch" VerticalAlignment="Center" IsChecked="{Binding TouchMode}" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ───────────── Library ───────────── -->
        <ScrollViewer x:Name="LibraryPage" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
          <StackPanel Margin="20,16">
            <TextBlock Classes="settings-group" Text="LIBRARY" />
            <Border Classes="settings-card">
              <StackPanel>
                <!-- Where Add to my music copies songs, from any source (#318) -->
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Songs you add go to" />
                    <TextBlock x:Name="KeepFolderText" Classes="setting-help" Text="{Binding Servers.KeepFolderText}" />
                    <TextBlock Classes="setting-help"
                               Text="Add to my music, on a server's songs, folders or playlists, copies them here, laid out as on the server: your own songs from then on, never removed by GZJam." />
                  </StackPanel>
                  <Button x:Name="KeepFolderButton" Grid.Column="1" Classes="hw" Content="CHANGE…" VerticalAlignment="Center"
                          Click="OnKeepFolderClick"
                          ToolTip.Tip="Another of your music folders for the songs you add from here on: those added already stay where they are" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Import from Mixxx" />
                    <TextBlock Classes="setting-help" Text="Ratings, crates (as labels), History and the BPMs you locked. Mixxx itself isn't changed." />
                  </StackPanel>
                  <Button x:Name="MixxxImportButton" Grid.Column="1" Classes="hw" Content="IMPORT…" VerticalAlignment="Center"
                          Click="OnMixxxImportClick" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Import playlists" />
                    <TextBlock Classes="setting-help"
                               Text="Playlists saved from MediaMonkey, foobar2000, iTunes, VirtualDJ and most other players, as .m3u or .m3u8 files, or as text from iTunes. Each becomes a playlist of the same name, in order. A folder of them keeps its folders, as folders of playlists." />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="PlaylistImportButton" Classes="hw" Content="FILES…" Click="OnPlaylistImportClick"
                            ToolTip.Tip="Pick playlist files: each becomes a playlist" />
                    <Button x:Name="PlaylistFolderImportButton" Classes="hw" Content="FOLDER…" Click="OnPlaylistFolderImportClick"
                            ToolTip.Tip="Pick a folder: every .m3u and .m3u8 in it and the folders in it, each folder a folder of playlists" />
                  </StackPanel>
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Ratings in the song files" />
                    <TextBlock Classes="setting-help"
                               Text="Star ratings that MediaMonkey, foobar2000 and other players save in the files, for songs that are unrated in GZJam. The files aren't changed." />
                  </StackPanel>
                  <Button x:Name="FileRatingsButton" Grid.Column="1" Classes="hw" Content="IMPORT…" VerticalAlignment="Center"
                          Click="OnFileRatingsClick" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Write tag edits into the song files" />
                    <TextBlock Classes="setting-help"
                               Text="Off, a tag you change in a song's info is kept in GZJam's library only: GZJam shows it and searches it, a backup keeps it, and the file isn't changed. On, it's written into the file too, so other players see it: only the tags, never the audio, and never while the song is on a deck." />
                  </StackPanel>
                  <ToggleButton x:Name="WriteTagsSwitch" Grid.Column="1" Classes="switch" VerticalAlignment="Center"
                                IsChecked="{Binding WriteTagsToFiles}" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Back up my library" />
                    <TextBlock Classes="setting-help"
                               Text="Hearts, labels, cues, playlists, History and your Settings, in one file: keep it on a USB stick or in a cloud folder. Your music files aren't in it. GZJam also keeps a copy of the last few days it was opened, beside the library." />
                    <TextBlock x:Name="LastBackupText" Classes="setting-help" FontWeight="SemiBold" Text="{Binding LastBackupText}" />
                  </StackPanel>
                  <Button x:Name="BackUpButton" Grid.Column="1" Classes="hw" Content="BACK UP…" VerticalAlignment="Center"
                          Click="OnBackUpClick" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Restore a backup" />
                    <TextBlock Classes="setting-help"
                               Text="Puts a backup's library and Settings back. GZJam asks first, then opens again with it; the library it replaces is kept, not deleted." />
                  </StackPanel>
                  <Button x:Name="RestoreButton" Grid.Column="1" Classes="hw" Content="RESTORE…" VerticalAlignment="Center"
                          Click="OnRestoreClick" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Start over with an empty library" />
                    <TextBlock Classes="setting-help"
                               Text="For a fresh start, or to add your music again from scratch. GZJam reopens with no music folders; the old library is kept, not deleted." />
                  </StackPanel>
                  <Button x:Name="StartOverButton" Grid.Column="1" Classes="hw" Content="START OVER…" VerticalAlignment="Center"
                          Command="{Binding StartOverCommand}" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Near a BPM" />
                    <TextBlock Classes="setting-help"
                               Text="How far ~bpm:140 searches reach either side, and the BPM button's Near Deck choices. ±8% is as far as the tempo slider goes. For one search, type ~bpm:140/5." />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Button x:Name="NearBpmCloserButton" Classes="hw step" Content="−" Command="{Binding NearBpmCloserCommand}" />
                    <Border Classes="readout-window" MinWidth="52">
                      <TextBlock Classes="mono" Text="{Binding NearBpmText}" FontWeight="SemiBold" FontSize="12.5"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button x:Name="NearBpmWiderButton" Classes="hw step" Content="+" Command="{Binding NearBpmWiderCommand}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ───────────── Servers ───────────── -->
        <!-- Music servers the DJ signed in to (#184, #282): a card each, then ADD A SERVER -->
        <ScrollViewer x:Name="ServersPage" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
          <StackPanel Margin="20,16">
            <TextBlock Classes="settings-group" Text="SERVERS" />
            <TextBlock Classes="setting-help" Margin="2,0,0,14" FontSize="12"
                       Text="Music from your own server: Navidrome, or another that speaks the Subsonic API, at home or reached over Tailscale. GZJam signs in with your account there; your server and its music aren't changed. Its songs are in the library, after your music folders: right-click it there to keep songs on this computer and sync them." />
            <ItemsControl x:Name="ServerList" ItemsSource="{Binding Servers.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerItemViewModel">
                  <Border Classes="settings-card" Margin="0,0,0,10">
                    <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="3">
                        <TextBlock Classes="setting" Text="{Binding Name}" />
                        <TextBlock Classes="setting-help" Text="{Binding SignIn}" />
                        <TextBlock x:Name="ServerStatus" Classes="setting-help" Classes.problem="{Binding IsProblem}" FontWeight="SemiBold"
                                   Text="{Binding Status}" />
                        <TextBlock Classes="setting-help problem" IsVisible="{Binding IsPreviewOnly}"
                                   Text="Preview only: this account can't download songs, so they can be heard in the headphones but never played to the room. Whoever runs the server can allow downloads." />
                        <TextBlock x:Name="ServerKept" Classes="setting-help" Text="{Binding KeptText}" Margin="0,4,0,0"
                                   IsVisible="{Binding KeptText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock x:Name="ServerSync" Classes="setting-help" Classes.problem="{Binding SyncProblem}" FontWeight="SemiBold"
                                   Text="{Binding SyncText}" IsVisible="{Binding HasSyncText}" />
                        <CheckBox x:Name="SendHeartsBox" IsChecked="{Binding SendHearts}" Margin="0,4,0,0"
                                  ToolTip.Tip="Stars are saved under your account on the server, so a friend's own aren't changed">
                          <TextBlock Classes="setting-help" Text="Send my hearts: a ♥ on one of its songs stars it there, so its own app shows the same favorites" TextWrapping="Wrap" />
                        </CheckBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                          <Button Classes="hw" Content="TEST" IsEnabled="{Binding !IsChecking}" Click="OnTestServerClick"
                                  ToolTip.Tip="Sign in to the server again" />
                          <Button Classes="hw" Content="EDIT…" Click="OnEditServerClick"
                                  ToolTip.Tip="Change the server's name, address, user name or password" />
                          <Button Classes="hw" Content="REMOVE…" Click="OnRemoveServerClick"
                                  ToolTip.Tip="Forget this server and its password (asks first)" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="settings-card" IsVisible="{Binding Servers.HasNoServers}" Margin="0,0,0,10">
              <TextBlock Classes="setting-help" Margin="14,12" Text="No servers yet." />
            </Border>
            <Button x:Name="AddServerButton" Classes="hw" Content="ADD A SERVER…" HorizontalAlignment="Left" Margin="0,2,0,12"
                    Click="OnAddServerClick" />
            <TextBlock x:Name="PasswordsText" Classes="setting-help" Margin="2,0,2,20" Text="{Binding Servers.PasswordsText}" />

            <TextBlock Classes="settings-group" Text="DOWNLOADED SONGS" />
            <Border Classes="settings-card">
              <StackPanel>
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Downloaded to" />
                    <TextBlock x:Name="DownloadsFolderText" Classes="setting-help" Text="{Binding Servers.DownloadsFolder}" />
                    <TextBlock x:Name="DownloadsText" Classes="setting-help" FontWeight="SemiBold" Text="{Binding Servers.DownloadsText}" />
                    <TextBlock Classes="setting-help"
                               Text="A music folder like your others, laid out as the server has it: songs from a server are on this computer before the night, so the room never depends on the Wi-Fi." />
                  </StackPanel>
                  <Button x:Name="DownloadsFolderButton" Grid.Column="1" Classes="hw" Content="CHANGE…" VerticalAlignment="Center"
                          IsEnabled="{Binding Servers.CanChangeDownloadsFolder}" Click="OnDownloadsFolderClick"
                          ToolTip.Tip="Another folder for downloaded songs, such as one on a bigger drive: the songs downloaded already move there, with their hearts, cues and EQ" />
                </Grid>
                <!-- Only once a server is being kept whole: they do nothing until then -->
                <StackPanel x:Name="KeepWholeSettings" IsVisible="{Binding Servers.KeepsAnyWhole}">
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Speed for copying a whole server" />
                    <TextBlock Classes="setting-help"
                               Text="For Add the whole server to my music (right-click a server), which copies every song on it into your music folder in the background. Slower leaves room on the home connection and the NAS for everyone else." />
                  </StackPanel>
                  <ComboBox x:Name="KeepSpeedBox" Grid.Column="1" Width="200" ItemsSource="{Binding Servers.KeepSpeedChoices}"
                            SelectedItem="{Binding Servers.KeepSpeed}" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Allow copying a whole server while music plays" />
                    <TextBlock Classes="setting-help"
                               Text="For Add the whole server to my music (right-click a server). Off: it copies only while no music is playing, and picks up where it left off. On: it copies at any time." />
                  </StackPanel>
                  <ToggleButton x:Name="KeepWhilePlayingSwitch" Grid.Column="1" Classes="switch" VerticalAlignment="Center"
                                IsChecked="{Binding Servers.KeepWhilePlaying}" />
                </Grid>
                </StackPanel>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Keep downloaded songs" />
                    <TextBlock x:Name="KeepDownloadsHelp" Classes="setting-help" Text="{Binding Servers.KeepDownloadsHelp}" />
                  </StackPanel>
                  <ComboBox x:Name="KeepDownloadsBox" Grid.Column="1" Width="200" ItemsSource="{Binding Servers.KeepDownloadsChoices}"
                            SelectedItem="{Binding Servers.KeepDownloadsChoice}" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Room for downloaded songs" />
                    <TextBlock Classes="setting-help" Text="When a sync would pass it, the downloads played least recently make room, never those of lists kept on this computer, the queue or a deck; a sync that still can't fit stops and says so. GZJam always leaves 1 GB free on the disk." />
                  </StackPanel>
                  <ComboBox x:Name="DownloadsLimitBox" Grid.Column="1" Width="200" ItemsSource="{Binding Servers.LimitChoices}"
                            SelectedItem="{Binding Servers.Limit}" />
                </Grid>
                <Border Classes="settings-rule" />
                <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="setting" Text="Sync when GZJam starts" />
                    <TextBlock Classes="setting-help"
                               Text="Each server that answers brings what you chose up to date, in the background. It pauses once the room hears music; SYNC finishes it." />
                  </StackPanel>
                  <ToggleButton x:Name="SyncAtStartupSwitch" Grid.Column="1" Classes="switch" VerticalAlignment="Center"
                                IsChecked="{Binding SyncServersAtStartup}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ───────────── About ───────────── -->
        <DockPanel x:Name="AboutPage" Margin="20,16" IsVisible="False">
          <StackPanel DockPanel.Dock="Top" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:LogoMark Width="30" Height="30" />
              <c:Wordmark Height="15" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                          AutomationProperties.Name="GZJam" />
              <TextBlock x:Name="VersionText" Classes="muted mono" FontSize="13" VerticalAlignment="Center" Margin="2,4,0,0" />
            </StackPanel>
            <TextBlock x:Name="MakerText" TextWrapping="Wrap" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="4" Margin="-6,-2,0,0">
              <!-- Each link says where it goes: an address beside "User guide" read as its destination -->
              <Button x:Name="GuideLink" Classes="link" Content="User guide" Click="OnGuideClick" Foreground="{StaticResource AccentBrush}"
                      ToolTip.Tip="{x:Static app:About.GuideUrl}" />
              <TextBlock Classes="muted" Text="·" VerticalAlignment="Center" />
              <Button x:Name="ProjectLink" Classes="link" Content="GZJam on GitHub" Click="OnProjectClick" Foreground="{StaticResource AccentBrush}"
                      ToolTip.Tip="{x:Static app:About.ProjectUrl}" />
            </StackPanel>
          </StackPanel>

          <Border DockPanel.Dock="Top" Classes="settings-card" Margin="0,12,0,0">
            <StackPanel>
              <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="setting" Text="Tell me when a new version is out" />
                  <TextBlock Classes="setting-help"
                             Text="At startup, GZJam asks GitHub for the newest release, and says so in the top bar before the music starts. Nothing about you or your music is sent, and nothing is downloaded. Off, GZJam never goes online by itself." />
                </StackPanel>
                <ToggleButton x:Name="CheckForNewVersionSwitch" Grid.Column="1" Classes="switch" VerticalAlignment="Center"
                              IsChecked="{Binding CheckForNewVersion}" />
              </Grid>
              <Border Classes="settings-rule" />
              <Grid Classes="settings-row" ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Classes="setting" Text="Check for a new version now" />
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock x:Name="CheckResultText" Classes="setting-help" Text="{Binding CheckResult}" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button x:Name="FoundReleaseLink" Classes="link" Content="What's new · Download" Click="OnFoundReleaseClick"
                            Foreground="{StaticResource AccentBrush}" Margin="2,-3,0,-3" VerticalAlignment="Center"
                            IsVisible="{Binding FoundRelease, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  </StackPanel>
                </StackPanel>
                <Button x:Name="CheckNowButton" Grid.Column="1" Classes="hw" Content="CHECK NOW" VerticalAlignment="Center"
                        Command="{Binding CheckNowCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,12,0,8">
            <TextBlock Classes="settings-group" Text="BUILT WITH" Margin="2,0,0,0" VerticalAlignment="Center" />
            <Button x:Name="NoticesButton" Grid.Column="1" Classes="hw" Content="FULL LICENSE TEXTS" Click="OnNoticesClick" />
          </Grid>
          <Border Classes="readout-window" Padding="12,10">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <SelectableTextBlock x:Name="BuiltWithText" Classes="mono" FontSize="11.5" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
