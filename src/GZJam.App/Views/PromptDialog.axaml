<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GZJam.App.Views.PromptDialog"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}"
        Title="GZJam">
  <!-- Asks for one short piece of text, e.g. a new label's name -->
  <StackPanel Margin="20" Spacing="12">
    <TextBlock x:Name="Heading" Classes="label" />
    <TextBox x:Name="Input" />
    <TextBlock x:Name="Message" Classes="setting-help" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button x:Name="CancelButton" Classes="hw" Content="CANCEL" IsCancel="True" MinWidth="88" />
      <Button x:Name="OkButton" Classes="hw" IsDefault="True" MinWidth="88" />
    </StackPanel>
  </StackPanel>
</Window>
