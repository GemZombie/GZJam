<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gzjam.ico</ApplicationIcon>
    <AssemblyName>GZJam</AssemblyName>
    <RootNamespace>GZJam.App</RootNamespace>
    <!-- Shown in Settings › About. Release builds set both from the tag (v0.2.0 → 0.2.0); a build
         made here says "-dev". -->
    <VersionPrefix>0.9.15</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <!-- Published packages are compiled ahead of time, so GZJam starts about a second sooner
         (it no longer compiles its code as it starts). Only a publish for a platform can. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!-- The licenses of everything GZJam ships with; About shows its opening list. -->
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window icon. The icon files are drawn by tools/GZJam.DevTools: icon <repo folder>. -->
    <AvaloniaResource Include="Assets\gzjam.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GZJam.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GZJam.Library\GZJam.Library.csproj" />
    <ProjectReference Include="..\GZJam.Audio\GZJam.Audio.csproj" />
  </ItemGroup>

  <Import Project="..\..\lib\bass\Bass.targets" />

  <!-- Packages leave out the debug symbols that come with other people's libraries: SkiaSharp's
       and HarfBuzzSharp's for Windows are 100 MB, more than the rest of the app. GZJam's own
       (a few KB) stay, so a crash report names the line. -->
  <Target Name="LeaveOutLibraryDebugSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(Extension)' == '.pdb' and '%(ResolvedFileToPublish.NuGetPackageId)' != ''" />
    </ItemGroup>
  </Target>

</Project>
