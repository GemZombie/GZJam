<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GZJam.App.Styles.TouchStyles">
  <!--
    Touch mode: finger-sized targets (about 44 px) for everything used during a set. Added to the
    app's styles while the setting is on and removed when it's off; everything here overrides a
    size in AppStyles.axaml or App.axaml. Gestures (dragging, long-press) work either way: this
    only changes sizes.
  -->
  <Styles.Resources>
    <x:Double x:Key="DeckButtonSize">62</x:Double>
    <x:Double x:Key="DeckControlHeight">42</x:Double>
    <x:Double x:Key="TopBarHeight">54</x:Double>
    <x:Double x:Key="DeckPlayIconSize">20</x:Double>
    <x:Double x:Key="DeckPauseIconSize">18</x:Double>
    <x:Double x:Key="CrossfaderHeight">56</x:Double>
    <x:Double x:Key="SmallKeyHeight">40</x:Double>
  </Styles.Resources>

  <!-- Library: rows, folders, search and its filter buttons -->
  <Style Selector="DataGrid.tracks">
    <Setter Property="RowHeight" Value="44" />
  </Style>
  <Style Selector="DataGrid.tracks DataGridColumnHeader">
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector="TreeView.folders TreeViewItem">
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector="TreeView.folders TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
    <Setter Property="Width" Value="40" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="Button.bpm-filter">
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.row-icon">
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <!-- Taller, not wider: links sit in tight rows (a deck's Eject beside its tempo fader). -->
  <Style Selector="Button.link">
    <Setter Property="Padding" Value="6,9" />
  </Style>

  <!-- Queue and history: taller rows and a wider grip to drag by -->
  <Style Selector="ListBox.queue ListBoxItem">
    <Setter Property="MinHeight" Value="52" />
  </Style>
  <Style Selector="ListBox.queue Border.grip">
    <Setter Property="Width" Value="40" />
  </Style>

  <!-- Keys and switches -->
  <Style Selector="Button.step">
    <Setter Property="MinWidth" Value="42" />
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="Button.side">
    <Setter Property="MinWidth" Value="60" />
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="Button.hw.jump">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="StackPanel.cue-keys">
    <Setter Property="Spacing" Value="8" />
  </Style>
  <Style Selector="Button.hw.cue-key">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="44" />
  </Style>
  <Style Selector="Button.eq-chip">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,2,9,2" />
  </Style>
  <Style Selector="Button.icon-button">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
  </Style>
  <Style Selector="Button.output-chip">
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="ToggleButton.switch">
    <Setter Property="MinWidth" Value="72" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector="Border.readout-window">
    <Setter Property="MinHeight" Value="40" />
  </Style>

  <!-- Menus and drop-downs -->
  <Style Selector="MenuItem">
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="42" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="44" />
  </Style>
</Styles>
