<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Rounded panel surfaces -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.panel-header">
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="42" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.3" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>

  <!-- Quiet text-style buttons ("+ Folder", "Clear") -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Search box -->
  <Style Selector="TextBox.search">
    <Setter Property="Background" Value="{StaticResource WellBrush}" />
    <Setter Property="BorderBrush" Value="#3A4152" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="34,7,30,7" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource WellBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource WellBrush}" />
  </Style>

  <!-- Scope chip -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="#248F74FF" />
    <Setter Property="BorderBrush" Value="#598F74FF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,3,4,3" />
  </Style>

  <!-- Folder tree -->
  <Style Selector="TreeView.folders TreeViewItem">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Track list -->
  <Style Selector="DataGrid.tracks">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="#1A1E26" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeight" Value="30" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="DataGrid.tracks DataGridColumnHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="DataGrid.tracks DataGridCell">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="DataGrid.tracks DataGridCell:current /template/ Grid#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="DataGrid.tracks DataGridCell.num">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>

  <!-- Queue -->
  <Style Selector="ListBox.queue">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="ListBox.queue ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
  </Style>
  <Style Selector="ListBox.queue ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#202530" />
  </Style>
  <Style Selector="ListBox.queue ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#388F74FF" />
  </Style>
  <Style Selector="ListBox.queue ListBoxItem:nth-child(1)">
    <Setter Property="BorderBrush" Value="#668F74FF" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Decks -->
  <Style Selector="Border.deck">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.deck.onair">
    <Setter Property="BorderBrush" Value="#73F04444" />
  </Style>
  <Style Selector="Border.deck.drop-ok">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.deck.drop-blocked">
    <Setter Property="BorderBrush" Value="{StaticResource OnAirBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="Border.pill.air">
    <Setter Property="Background" Value="{StaticResource OnAirBrush}" />
  </Style>
  <Style Selector="Border.pill.air > TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.pill.offair > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>

  <!-- Per-deck cue (headphones) toggle; lit amber when on -->
  <Style Selector="ToggleButton.cue-button">
    <Setter Property="MinHeight" Value="{DynamicResource DeckControlHeight}" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="ToggleButton.cue-button:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Deck2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Deck2Brush}" />
  </Style>
  <Style Selector="ToggleButton.cue-button:checked">
    <Setter Property="Foreground" Value="#111" />
  </Style>
  <Style Selector="ToggleButton.cue-button:checked:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#FFB84A" />
  </Style>

  <Style Selector="Border.hint">
    <Setter Property="Background" Value="#E61F2430" />
    <Setter Property="BorderBrush" Value="#39404F" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <!-- The big readout is a button you tap to cycle; it shouldn't look like one. -->
  <Style Selector="Button.readout">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.readout:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0DFFFFFF" />
  </Style>
  <Style Selector="Button.readout:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#1AFFFFFF" />
  </Style>

  <Style Selector="Button.play">
    <Setter Property="Width" Value="{DynamicResource DeckButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource DeckButtonSize}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Button.play.playing /template/ ContentPresenter">
    <Setter Property="Background" Value="#1AFFFFFF" />
  </Style>
  <!-- Filling up while the live deck's pause is being held -->
  <Style Selector="Button.play.holding /template/ ContentPresenter">
    <Setter Property="Background" Value="#55F04444" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.6" />
      </Transitions>
    </Setter>
  </Style>
  <!-- First of two taps to pause an on-air deck: waiting for the second -->
  <Style Selector="Button.play.armed /template/ ContentPresenter">
    <Setter Property="Background" Value="#66F04444" />
  </Style>
  <Style Selector="Button.play:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <Style Selector="Button.deck-button">
    <Setter Property="MinHeight" Value="{DynamicResource DeckControlHeight}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <!-- Auto-play panel: lights up green when on -->
  <Style Selector="Border.autoplay">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#3334D399" />
    <Setter Property="Background" Value="#0A34D399" />
  </Style>
  <Style Selector="Border.autoplay.on">
    <Setter Property="BorderBrush" Value="#8034D399" />
    <Setter Property="Background" Value="#2234D399" />
  </Style>

  <!-- Small − / + steppers (gap) -->
  <Style Selector="Button.step">
    <Setter Property="MinWidth" Value="{DynamicResource DeckControlHeight}" />
    <Setter Property="MinHeight" Value="{DynamicResource DeckControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.side">
    <Setter Property="MinHeight" Value="{DynamicResource DeckControlHeight}" />
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Panel tabs (Queue / History) -->
  <Style Selector="ToggleButton.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="MinHeight" Value="{DynamicResource DeckControlHeight}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.tab:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource OkBrush}" />
  </Style>
  <Style Selector="ToggleButton.tab:checked">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0DFFFFFF" />
  </Style>
  <Style Selector="ListBox.history ListBoxItem:nth-child(1)">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Top bar -->
  <Style Selector="Button.output-chip">
    <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon-button">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.preview-bar">
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#24F5A524" Offset="0" />
        <GradientStop Color="#00F5A524" Offset="0.7" />
      </LinearGradientBrush>
    </Setter>
  </Style>

  <!-- Small icon buttons in list rows (preview) -->
  <Style Selector="Button.row-icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.row-icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Button.row-icon.active">
    <Setter Property="Foreground" Value="{StaticResource Deck2Brush}" />
  </Style>
  <Style Selector="Button.row-icon:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Deck2Brush}" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="Foreground" Value="#0C0E12" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.well">
    <Setter Property="Background" Value="{StaticResource WellBrush}" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
</Styles>
