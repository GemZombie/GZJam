<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:GZJam.App.Controls"
        xmlns:app="using:GZJam.App"
        xmlns:lib="using:GZJam.Library">

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource BgBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Panel surfaces: square-ish, like equipment rather than cards -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.panel-header">
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Height" Value="42" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.3" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
  </Style>

  <!-- Quiet text-style buttons ("+ Folder", "Clear") -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.link:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Search box -->
  <Style Selector="TextBox.search">
    <Setter Property="Background" Value="{StaticResource WellBrush}" />
    <Setter Property="BorderBrush" Value="#3A4152" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="34,7,30,7" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource WellBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox.search:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource WellBrush}" />
  </Style>

  <!-- Scope chip -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="9,3,4,3" />
  </Style>

  <!-- The BPM filter button by the search box; tinted like the scope chip while a filter is set -->
  <Style Selector="Button.bpm-filter">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="Button.bpm-filter.on">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <!-- Folder tree -->
  <Style Selector="TreeView.folders TreeViewItem">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <!-- A folder's arrow takes the whole space before its name, the row's full height (the
       standard arrow is a 12 px target) -->
  <Style Selector="TreeView.folders TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
    <Setter Property="Margin" Value="0" />
    <Setter Property="Width" Value="32" />
  </Style>
  <Style Selector="TreeView.folders TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="Transparent">
          <Path x:Name="ChevronPath" Width="12" Height="12" Stretch="Uniform"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Fill="{DynamicResource TreeViewItemForeground}"
                Data="M 1,0 10,10 l -9,10 -1,-1 L 8,10 -0,1 Z" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TreeView.folders TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:checked /template/ Path#ChevronPath">
    <Setter Property="Data" Value="M0,1 L10,10 20,1 19,0 10,8 1,0 Z" />
  </Style>

  <!-- Track list -->
  <Style Selector="DataGrid.tracks">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="#1A1E26" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeight" Value="30" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="DataGrid.tracks DataGridColumnHeader">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <!-- A song's labels, after its title -->
  <Style Selector="Border.label-chip">
    <Setter Property="Background" Value="#1C222C" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="5,0,5,1" />
  </Style>
  <Style Selector="Border.label-chip > TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <!-- Smaller under a queue row's title, so a row with labels is no taller than one without -->
  <Style Selector="ItemsControl.small Border.label-chip">
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <Style Selector="ItemsControl.small Border.label-chip > TextBlock">
    <Setter Property="FontSize" Value="9.5" />
  </Style>

  <!-- Played tonight: dimmed, so it isn't played again by mistake -->
  <Style Selector="DataGrid.tracks DataGridRow" x:DataType="lib:Track">
    <Setter Property="Opacity" Value="{Binding IsPlayedTonight, Converter={x:Static app:Converters.Dimmed}}" />
  </Style>
  <Style Selector="DataGrid.tracks DataGridCell">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="DataGrid.tracks DataGridCell:current /template/ Grid#FocusVisual">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="DataGrid.tracks DataGridCell.num">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="HorizontalContentAlignment" Value="Right" />
  </Style>

  <!-- Queue -->
  <Style Selector="ListBox.queue">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.queue ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="#1C2027" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="ListBox.queue ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0AFFFFFF" />
  </Style>
  <Style Selector="ListBox.queue ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>
  <!-- The song auto-play takes next: a thin bar at its left edge -->
  <Style Selector="Border.next-bar">
    <Setter Property="Width" Value="2" />
    <Setter Property="Background" Value="{StaticResource MutedBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- Hardware-style keys: dark, square-ish, bold small caps; state is shown by an LED, not by
       filling the key with colour. Works for Button and ToggleButton. -->
  <Style Selector=":is(Button).hw">
    <Setter Property="Background" Value="{StaticResource KeyBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource KeyEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="MinHeight" Value="{DynamicResource DeckControlHeight}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector=":is(Button).hw:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource KeyHoverBrush}" />
    <Setter Property="BorderBrush" Value="#46505E" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector=":is(Button).hw:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource KeyPressedBrush}" />
  </Style>
  <Style Selector="ToggleButton.hw:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource KeyBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource KeyEdgeBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.hw:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource KeyHoverBrush}" />
  </Style>
  <Style Selector=":is(Button).hw:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource KeyBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource KeyEdgeBrush}" />
  </Style>
  <Style Selector=":is(Button).hw:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- The JUMP key, small, over the waveform -->
  <Style Selector=":is(Button).hw.small">
    <Setter Property="MinHeight" Value="{DynamicResource SmallKeyHeight}" />
  </Style>
  <Style Selector="Button.hw.jump">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>
  <!-- Cue keys 1-4, small, over the bottom left of the waveform -->
  <Style Selector="StackPanel.cue-keys">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="Button.hw.cue-key">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="MinWidth" Value="26" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Opacity" Value="0.92" />
  </Style>

  <!-- LEDs: dark when off; lit with a soft glow. Colour by meaning: red = the room, amber = the
       headphones, green = running, accent = something you set. -->
  <Style Selector="Border.led">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="#262B33" />
    <Setter Property="BorderBrush" Value="#111318" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.led.on">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.led.on.red">
    <Setter Property="Background" Value="{StaticResource OnAirBrush}" />
    <Setter Property="BoxShadow" Value="0 0 6 1 #B3F04444" />
  </Style>
  <Style Selector="Border.led.on.amber">
    <Setter Property="Background" Value="{StaticResource Deck2Brush}" />
    <Setter Property="BoxShadow" Value="0 0 6 1 #B3F5A524" />
  </Style>
  <Style Selector="Border.led.on.green">
    <Setter Property="Background" Value="{StaticResource OkBrush}" />
    <Setter Property="BoxShadow" Value="0 0 6 1 #B334D399" />
  </Style>
  <Style Selector="Border.led.on.accent">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BoxShadow" Value="0 0 6 1 #B37FA3CF" />
  </Style>

  <!-- A deck's ON AIR / OFF AIR, beside its LED -->
  <Style Selector="TextBlock.status">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.2" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.status.air">
    <Setter Property="Foreground" Value="{StaticResource OnAirBrush}" />
  </Style>
  <!-- The dividers between the folders, the library and the queue: a short grip in the middle of
       the gap, so it's plain where to drag, by finger as well as mouse -->
  <Style Selector="Border.splitter-grip">
    <Setter Property="Width" Value="4" />
    <Setter Property="Height" Value="36" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{StaticResource Line2Brush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="GridSplitter.panes">
    <Setter Property="Cursor" Value="SizeWestEast" />
    <!-- Above the panels, which it overlaps in touch mode -->
    <Setter Property="ZIndex" Value="1" />
  </Style>
  <!-- A deck's name above its title, printed like a label on hardware, in the deck's colour -->
  <Style Selector="TextBlock.deck-name">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- With four decks, just the number, before the art -->
  <Style Selector="TextBlock.deck-number">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <!-- Decks -->
  <Style Selector="Border.deck">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.deck.drop-ok">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.deck.drop-blocked">
    <Setter Property="BorderBrush" Value="{StaticResource OnAirBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- The song being dragged, following the pointer; red edged over a deck that won't take it -->
  <Style Selector="Border.drag-tag">
    <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="11,7" />
    <Setter Property="BoxShadow" Value="0 6 18 0 #99000000" />
  </Style>
  <Style Selector="Border.drag-tag.blocked">
    <Setter Property="BorderBrush" Value="{StaticResource OnAirBrush}" />
  </Style>

  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>
  <Style Selector="Border.pill.air">
    <Setter Property="Background" Value="{StaticResource OnAirBrush}" />
  </Style>
  <Style Selector="Border.pill.air > TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.pill.offair > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>

  <!-- The limiter light in the mixer: dark until the speakers are too loud -->
  <Style Selector="Border.limit">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
  </Style>
  <Style Selector="Border.limit > TextBlock">
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
  </Style>
  <Style Selector="Border.limit.on">
    <Setter Property="Background" Value="{StaticResource OnAirBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource OnAirBrush}" />
  </Style>
  <Style Selector="Border.limit.on > TextBlock">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Main and phones faders: 0-100 on the audio taper, with lines at the dB marks
       (0, -6, -12, -18, -24, -30, -40 dB, off); the slot lit grey up to the cap. -->
  <Style Selector="c|Fader.volume">
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Step" Value="1" />
    <Setter Property="Origin" Value="0" />
    <Setter Property="LightLines" Value="False" />
    <Setter Property="Lines" Value="0,10,17.78,25.12,35.48,50.12,70.79,100" />
  </Style>
  <Style Selector="TextBlock.fader-label">
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  </Style>

  <Style Selector="Border.hint">
    <Setter Property="Background" Value="#E61F2430" />
    <Setter Property="BorderBrush" Value="#39404F" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <!-- The big readout is a button you tap to cycle; it shouldn't look like one. -->
  <Style Selector="Button.readout">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- Nothing loaded: the readout stays out of the way -->
  <Style Selector="Button.readout.empty">
    <Setter Property="Opacity" Value="0.3" />
  </Style>
  <Style Selector="Button.readout:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0DFFFFFF" />
  </Style>
  <Style Selector="Button.readout:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#1AFFFFFF" />
  </Style>

  <Style Selector="Button.play">
    <Setter Property="Width" Value="{DynamicResource DeckButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource DeckButtonSize}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Background" Value="{StaticResource KeyBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource KeyHoverBrush}" />
  </Style>
  <Style Selector="Button.play:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource KeyPressedBrush}" />
  </Style>
  <!-- Filling up while the live deck's pause is being held -->
  <Style Selector="Button.play.holding /template/ ContentPresenter">
    <Setter Property="Background" Value="#55F04444" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.6" />
      </Transitions>
    </Setter>
  </Style>
  <!-- First of two taps to pause an on-air deck: waiting for the second -->
  <Style Selector="Button.play.armed /template/ ContentPresenter">
    <Setter Property="Background" Value="#66F04444" />
  </Style>
  <Style Selector="Button.play:disabled">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <Style Selector="Button.deck-button">
    <Setter Property="MinHeight" Value="{DynamicResource DeckControlHeight}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <!-- Auto-play strip above the queue tabs -->
  <Style Selector="Border.autoplay">
    <Setter Property="Padding" Value="10,10,10,8" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- Small − / + keys (gap) -->
  <Style Selector="Button.step">
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="15" />
  </Style>
  <!-- A small dark readout window, like an LCD on a mixer -->
  <Style Selector="Border.readout-window">
    <Setter Property="Background" Value="#07090C" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="Button.side">
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Panel tabs (Queue / History) -->
  <Style Selector="ToggleButton.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="MinHeight" Value="{DynamicResource DeckControlHeight}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ToggleButton.tab:checked /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.tab:checked">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.tab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#0DFFFFFF" />
  </Style>
  <Style Selector="ListBox.history ListBoxItem:nth-child(1)">
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Top bar -->
  <Style Selector="Button.output-chip">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Windows' minimise, maximise and close, in the top bar (MainWindow.TitleBar.cs) -->
  <Style Selector="Button.caption">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1AFFFFFF" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#33FFFFFF" />
  </Style>
  <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.icon-button">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.preview-bar">
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Background" Value="#11141A" />
  </Style>
  <Style Selector="Border.preview-edge">
    <Setter Property="Width" Value="2" />
    <Setter Property="Background" Value="{StaticResource Deck2Brush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="-12,-8,0,-8" />
  </Style>

  <!-- On/off settings: a key with an LED and ON / OFF, instead of a phone-style switch -->
  <Style Selector="ToggleButton.switch">
    <Setter Property="MinWidth" Value="62" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Key" Background="{StaticResource KeyBrush}" BorderBrush="{StaticResource KeyEdgeBrush}"
                BorderThickness="1" CornerRadius="4" Padding="9,0" MinHeight="{TemplateBinding MinHeight}">
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border x:Name="PART_Led" Classes="led green" />
            <TextBlock x:Name="PART_Text" Text="OFF" FontSize="10.5" FontWeight="Bold" LetterSpacing="0.8"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ Border#PART_Led">
    <Setter Property="Background" Value="{StaticResource OkBrush}" />
    <Setter Property="BoxShadow" Value="0 0 6 1 #B33CC97C" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ToggleButton.switch:checked /template/ TextBlock#PART_Text">
    <Setter Property="Text" Value="ON" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="ToggleButton.switch:pointerover /template/ Border#PART_Key">
    <Setter Property="Background" Value="{StaticResource KeyHoverBrush}" />
  </Style>
  <Style Selector="ToggleButton.switch:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- A setting's name and its explanation -->
  <Style Selector="TextBlock.setting">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.setting-help">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Settings: a panel over the dimmed screen, with sections down the side (Views/SettingsPanel) -->
  <Style Selector="Border.settings">
    <Setter Property="Background" Value="{StaticResource SettingsBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SettingsEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BoxShadow" Value="0 16 48 0 #99000000" />
  </Style>
  <Style Selector="Border.settings-head">
    <Setter Property="Background" Value="{StaticResource SettingsHeadBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SettingsLineBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="16,8,10,8" />
  </Style>
  <Style Selector="TextBlock.settings-title">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.8" />
    <Setter Property="Foreground" Value="#C9D0DC" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="RadioButton.settings-nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Item" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0"
                Padding="15,0" MinHeight="{DynamicResource DeckControlHeight}">
          <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.settings-nav:pointerover /template/ Border#PART_Item">
    <Setter Property="Background" Value="#0AFFFFFF" />
  </Style>
  <Style Selector="RadioButton.settings-nav:checked /template/ Border#PART_Item">
    <Setter Property="Background" Value="#262C37" />
    <Setter Property="BorderBrush" Value="#C9D0DC" />
  </Style>
  <Style Selector="RadioButton.settings-nav:checked">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.settings-group">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.6" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="Margin" Value="2,0,0,7" />
  </Style>
  <Style Selector="Border.settings-card">
    <Setter Property="Background" Value="{StaticResource SettingsCardBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource SettingsLineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
  <!-- One setting: its name and explanation on the left, the control on the right -->
  <Style Selector="Grid.settings-row">
    <Setter Property="ColumnSpacing" Value="16" />
    <Setter Property="Margin" Value="14,11" />
  </Style>
  <Style Selector="Border.settings-rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource SettingsLineBrush}" />
  </Style>
  <Style Selector="Border.settings-card ComboBox">
    <Setter Property="Width" Value="270" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Small icon buttons in list rows (preview) -->
  <Style Selector="Button.row-icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.row-icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#14FFFFFF" />
  </Style>
  <Style Selector="Button.row-icon.active">
    <Setter Property="Foreground" Value="{StaticResource Deck2Brush}" />
  </Style>
  <Style Selector="Button.row-icon:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Deck2Brush}" />
  </Style>
  <!-- The EQ panel's frame: the app's panel colours rather than the stock flyout grey -->
  <Style Selector="FlyoutPresenter.eq, FlyoutPresenter.panel">
    <Setter Property="Background" Value="{StaticResource PanelBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16,14" />
  </Style>

  <!-- A deck's EQ button: a tiny key whose LED is lit while the song has EQ set -->
  <Style Selector="Button.eq-chip">
    <Setter Property="Background" Value="{StaticResource KeyBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource KeyEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="5,1,6,1" />
    <Setter Property="MinHeight" Value="18" />
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.eq-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource KeyHoverBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>
  <Style Selector="Button.eq-chip Border.led">
    <Setter Property="Width" Value="5" />
    <Setter Property="Height" Value="5" />
  </Style>

  <Style Selector="Border.well">
    <Setter Property="Background" Value="{StaticResource WellBrush}" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
</Styles>
