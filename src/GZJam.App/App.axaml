<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GZJam.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <!-- Palette, matching docs/mockups/main-screen.html -->
      <Color x:Key="BgColor">#0C0E12</Color>
      <Color x:Key="PanelColor">#13161C</Color>
      <Color x:Key="Panel2Color">#191D25</Color>
      <Color x:Key="WellColor">#0E1116</Color>
      <Color x:Key="LineColor">#252A34</Color>
      <Color x:Key="Line2Color">#2F3542</Color>
      <Color x:Key="TextColor">#E7EAF0</Color>
      <Color x:Key="MutedColor">#8B94A5</Color>
      <Color x:Key="DimColor">#5D6574</Color>
      <Color x:Key="Deck1Color">#36C2DC</Color>
      <Color x:Key="Deck2Color">#EEA23A</Color>
      <Color x:Key="Deck3Color">#DB7FA8</Color>
      <Color x:Key="Deck4Color">#9DC653</Color>
      <Color x:Key="OnAirColor">#F04444</Color>
      <Color x:Key="OkColor">#3CC97C</Color>
      <Color x:Key="AccentColor">#7FA3CF</Color>

      <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
      <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
      <SolidColorBrush x:Key="Panel2Brush" Color="{StaticResource Panel2Color}" />
      <SolidColorBrush x:Key="WellBrush" Color="{StaticResource WellColor}" />
      <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
      <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}" />
      <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
      <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
      <SolidColorBrush x:Key="DimBrush" Color="{StaticResource DimColor}" />
      <SolidColorBrush x:Key="Deck1Brush" Color="{StaticResource Deck1Color}" />
      <SolidColorBrush x:Key="Deck2Brush" Color="{StaticResource Deck2Color}" />
      <SolidColorBrush x:Key="Deck3Brush" Color="{StaticResource Deck3Color}" />
      <SolidColorBrush x:Key="Deck4Brush" Color="{StaticResource Deck4Color}" />
      <SolidColorBrush x:Key="OnAirBrush" Color="{StaticResource OnAirColor}" />
      <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#337FA3CF" />
      <SolidColorBrush x:Key="AccentFaintBrush" Color="#1F7FA3CF" />
      <SolidColorBrush x:Key="Deck2SoftBrush" Color="#24EEA23A" />

      <!-- Settings: a lighter, bluer grey than the decks, so it never passes for part of the set -->
      <SolidColorBrush x:Key="SettingsBrush" Color="#1C2028" />
      <SolidColorBrush x:Key="SettingsHeadBrush" Color="#242A34" />
      <SolidColorBrush x:Key="SettingsNavBrush" Color="#191D24" />
      <SolidColorBrush x:Key="SettingsCardBrush" Color="#21262F" />
      <SolidColorBrush x:Key="SettingsLineBrush" Color="#343B48" />
      <SolidColorBrush x:Key="SettingsEdgeBrush" Color="#3E4654" />

      <!-- Hardware-style keys (Button.hw): moulded dark plastic, a touch lighter under the pointer -->
      <LinearGradientBrush x:Key="KeyBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#2A2F39" Offset="0" />
        <GradientStop Color="#1D2129" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="KeyHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#333946" Offset="0" />
        <GradientStop Color="#242933" Offset="1" />
      </LinearGradientBrush>
      <SolidColorBrush x:Key="KeyPressedBrush" Color="#171A20" />
      <SolidColorBrush x:Key="KeyEdgeBrush" Color="#363C48" />

      <!-- First available wins: Windows, macOS, Linux. -->
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, SF Mono, Menlo, DejaVu Sans Mono, monospace</FontFamily>

      <!--
        Sizes for controls used during a set. Touch mode (Styles/TouchStyles.axaml) swaps these for
        finger-sized values, so new controls should take their sizes from here via DynamicResource.
      -->
      <x:Double x:Key="DeckButtonSize">54</x:Double>
      <x:Double x:Key="DeckControlHeight">36</x:Double>
      <x:Double x:Key="DeckPlayIconSize">18</x:Double>
      <x:Double x:Key="DeckPauseIconSize">16</x:Double>
      <x:Double x:Key="CrossfaderHeight">44</x:Double>
      <!-- Keys in tight spots: STOP, auto-play, NAME -->
      <x:Double x:Key="SmallKeyHeight">30</x:Double>

      <!-- Fluent theme overrides: small corners; menus, drop-downs and flyouts in the panel colours -->
      <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#171A21" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2F3542" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#262C38" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#1E232C" />
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#13161C" />
      <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#2F3542" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#0E1116" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#141820" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2F3542" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#46505E" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#171A21" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2F3542" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#262C38" />
      <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#2E7FA3CF" />
      <SolidColorBrush x:Key="TextControlBackground" Color="#0E1116" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#0E1116" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0E1116" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2F3542" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#7FA3CF" />
      <Color x:Key="SystemAccentColor">#6F93C0</Color>
      <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#2E7FA3CF" />
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#3D7FA3CF" />
      <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#227FA3CF" />
      <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#307FA3CF" />
      <SolidColorBrush x:Key="DataGridRowHoveredBackgroundColor" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="Transparent" />
      <SolidColorBrush x:Key="DataGridColumnHeaderForegroundBrush" Color="{StaticResource MutedColor}" />
      <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#1A1E26" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#2E7FA3CF" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#3D7FA3CF" />

      <!-- Icons -->
      <StreamGeometry x:Key="IconHeadphones">M3 15v-3a9 9 0 0 1 18 0v3 M2.5 15.5a1.5 1.5 0 0 1 1.5-1.5h2a1.5 1.5 0 0 1 1.5 1.5v4a1.5 1.5 0 0 1-1.5 1.5h-2a1.5 1.5 0 0 1-1.5-1.5z M16.5 15.5a1.5 1.5 0 0 1 1.5-1.5h2a1.5 1.5 0 0 1 1.5 1.5v4a1.5 1.5 0 0 1-1.5 1.5h-2a1.5 1.5 0 0 1-1.5-1.5z</StreamGeometry>
      <StreamGeometry x:Key="IconSpeaker">M11 5L6 9H2v6h4l5 4z M15.5 8.5a5 5 0 0 1 0 7 M19 5a10 10 0 0 1 0 14</StreamGeometry>
      <StreamGeometry x:Key="IconFolder">M3 6.5A1.5 1.5 0 0 1 4.5 5h4.2l2 2h8.8A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z</StreamGeometry>
      <StreamGeometry x:Key="IconSearch">M11 4a7 7 0 1 1 0 14a7 7 0 1 1 0-14z M16 16l4.5 4.5</StreamGeometry>
      <StreamGeometry x:Key="IconPause">M6 5h4v14H6z M14 5h4v14h-4z</StreamGeometry>
      <StreamGeometry x:Key="IconGear">M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z M12 9a3 3 0 1 1 0 6a3 3 0 1 1 0-6z</StreamGeometry>
      <StreamGeometry x:Key="IconPlay">M8 5.5v13a1 1 0 0 0 1.5.9l10-6.5a1 1 0 0 0 0-1.7l-10-6.5A1 1 0 0 0 8 5.5z</StreamGeometry>
      <StreamGeometry x:Key="IconClose">M6 6l12 12 M18 6L6 18</StreamGeometry>
      <StreamGeometry x:Key="IconGrip">M9 6h.01 M15 6h.01 M9 12h.01 M15 12h.01 M9 18h.01 M15 18h.01</StreamGeometry>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
